; SYSTEM_TITLE.ERB
; 自定义标题界面 
; Edit 1.0

@SYSTEM_TITLE

$TITLE_SELECT

REDRAW 0
LOADGLOBAL
CALL INIT_DISPLAY_SETTINGS
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

; ==================================================
; 标题区：
; ==================================================
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
DRAWLINE
ALIGNMENT CENTER
PRINTL                    ◇  E R A  _  A I  ◇
PRINTL
PRINTL                    - Text Adventure System -
PRINTL
PRINTL                    Ver 1.0 测试版
PRINTL
PRINTL                    创作者：Natepage
ALIGNMENT LEFT
DRAWLINE
DRAWLINE

; ==================================================
; 菜单区：
; ==================================================
PRINTL                [0] 开始新游戏     New Game      [从第一天开始，进入新的故事流程]
PRINTL                [1] 读取存档         Continue         [载入已有进度，继续上次的游戏]
PRINTL                [2] 游戏说明         Guide              [查看基础玩法、配置要求、更新内容]
PRINTL                [3] 设置                Options           [调整显示、系统流程、AI相关选项]
PRINTL                [4] 关于                About              [查看项目版本、制作信息、开发目标]
PRINTL                [9] 退出游戏         Exit                  [关闭程序并返回桌面]

; ==================================================
; 输入处理
; ==================================================
$TITLE_INPUT
INPUT

SELECTCASE RESULT
    CASE 0
        DRAWLINE
        RESETDATA
        BEGIN FIRST
; 调用新游戏入口 @EVENTFIRST

    CASE 1
	CLEARLINE LINECOUNT
        LOADGAME
; 调用自带的加载存档功能（底下的日文不好改）
        GOTO TITLE_SELECT

    CASE 2
        CALL TITLE_HELP
        GOTO TITLE_SELECT

    CASE 3
        CALL TITLE_SETTING
        GOTO TITLE_SELECT

    CASE 4
        CALL TITLE_ABOUT
        GOTO TITLE_SELECT

    CASE 9
        CALL TITLE_EXIT_CONFIRM
        GOTO TITLE_SELECT

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_INPUT
ENDSELECT

; ==================================================
; 游戏说明页面
; ==================================================
@TITLE_HELP

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 游戏说明 / Game Guide
ALIGNMENT LEFT
DRAWLINE
PRINTL 本页面用于说明当前版本的基础玩法、配置要求和已完成内容。
DRAWLINE
PRINTL   本项目是一个基于 Era / Emuera 风格制作的文字游戏。游戏以文本叙事、菜单选择和数值变化作为主要表现方式。
PRINTL   玩家将在简洁的文字界面中推进流程，
PRINTL   通过不同选择影响角色状态、事件发展和后续剧情。
DRAWLINE
PRINTL 当前更新内容
PRINTL   ・已加入测试剧本“雨夜房间”
DRAWLINE
PRINTL 配置要求
PRINTL
PRINTL   运行环境：
PRINTL     ・操作系统：Windows 10 / Windows 11，建议使用 64 位系统
PRINTL     ・运行器：Emuera / Emuera.NET
PRINTL     ・运行库：若使用 Emuera.NET，需要安装 .NET Desktop Runtime x64
PRINTL     ・文件编码：建议 ERB / CSV 文件使用 UTF-8 with BOM
PRINTL
PRINTL   需求配置：
PRINTL     ・CPU：建议 6 核 12 线程及以上
PRINTL     ・内存：建议 32GB 以上，推荐 64GB
PRINTL     ・显卡：建议 NVIDIA 显卡，显存 8GB 以上
PRINTL     ・硬盘空间：建议额外预留 50GB 以上用于模型文件
PRINTL     ・运行方式：可使用本地 AI 模型，也可连接外部 AI 服务
PRINTL
PRINTL   推荐配置：
PRINTL     ・CPU：Ryzen 7 / Core i7 级别及以上
PRINTL     ・内存：64GB
PRINTL     ・显卡：RTX 4070 8GB 或更高
PRINTL     ・硬盘空间：建议预留 100GB 以上
PRINTL
PRINTL   说明：
PRINTL     ・仅游玩基础文字内容时，不需要高配置（作者不会更新无AI版本，需自行修改）
PRINTL     ・启用本地 AI 对话后，模型大小会直接影响速度和内存占用
PRINTL     ・较小模型响应更快，较大模型角色表现和上下文稳定性更好
PRINTL     ・如果使用外部 AI 服务，本机配置要求会明显降低
DRAWLINE
PRINTL [0] 返回标题

$TITLE_HELP_INPUT
INPUT
IF RESULT == 0
    RETURN
ELSE
    CLEARLINE 1
    REUSELASTLINE 输入无效，请输入 0 返回标题。
    GOTO TITLE_HELP_INPUT
ENDIF

; ==================================================
; 设置页面
; ==================================================
@TITLE_SETTING

$TITLE_SETTING_SELECT

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 设置 / Options
ALIGNMENT LEFT
DRAWLINE
PRINTL 本页面用于管理游戏显示、系统流程和 AI 对话等相关选项。
DRAWLINE

PRINTFORM 显示设置     [文本：
CALL PRINT_TEXT_COLOR_NAME
PRINTFORM  / 背景：
CALL PRINT_BG_COLOR_NAME
PRINTL ]

PRINTFORM [1] 文本颜色        当前：
CALL PRINT_TEXT_COLOR_NAME
PRINTL

PRINTFORM [2] 背景颜色        当前：
CALL PRINT_BG_COLOR_NAME
PRINTL

PRINTL [3] 字体样式        当前：请在 emuera.config 中修改
PRINTL [4] 字体大小        当前：请在 emuera.config 中修改
PRINTL [5] 行距设置        当前：请在 emuera.config 中修改

DRAWLINE
; ==================================================
; 游戏设置区
; 说明：
;   当前这里负责“设置开关”的显示与保存。
;   自动存档和返回确认已经接入主流程。
;
;   GLOBAL:300 自动存档
;       1 = 开，0 = 关
;       当前在雨夜房间每轮对话结束后调用自动存档，写入 99 号槽位。
;
;   GLOBAL:301 返回确认
;       1 = 开，0 = 关
;       当前已经接入“退出游戏”“返回标题”等确认流程。
; ==================================================
PRINTFORM 游戏设置     [自动存档：
CALL PRINT_AUTOSAVE_NAME
PRINTFORM  / 返回确认：
CALL PRINT_RETURN_CONFIRM_NAME
PRINTL ]

PRINTFORM [6] 自动存档        当前：
CALL PRINT_AUTOSAVE_NAME
PRINTL

PRINTFORM [7] 返回确认        当前：
CALL PRINT_RETURN_CONFIRM_NAME
PRINTL

DRAWLINE
; ==================================================
; AI 对话设置区
; 说明：
;   本项目默认启用 AI，因此不设置“AI 开关”。
;   当前这里负责 AI 参数的显示、保存，并读取 AI Bridge 写出的模型状态。
;   AI 通信测试页已经接入 AI Bridge，可以通过 GX / mock / OpenAI 后端返回回复。
;   正式剧本对话已接入雨夜房间；长期记忆由 AI Bridge 写入 cache 文件夹。
;
;   GLOBAL:400 模型来源
;       0 = 本地，1 = 外部服务
;       注意：真实后端 mock / gx / openai 由 AI/AI_CONFIG.txt 中的 MODEL_SOURCE 决定。
;
;   GLOBAL:401 模型名称状态
;       当前显示值由 AI/model_name.txt 提供。
;       该文件由 AI/ai_bridge.py 根据 AI_CONFIG.txt 自动写入。
;
;   GLOBAL:402 回复上限 Token
;       控制 AI 单次回复最多生成多少 Token。
;       AI Bridge 已读取该值，用于控制本次模型回复上限。
;
;   GLOBAL:403 记忆容量 Token
;       控制每次 AI 对话最多读取多少 Token 的角色记忆、事件摘要、关系变化等内容。
;       当前已经传给 AI Bridge，并用于裁剪 cache 长期记忆与历史摘录。
;       0 表示不读取长期记忆。
;
;   GLOBAL:404 对话风格
;       控制 AI 回复时的语气、描写密度和表达方式。
;       AI Bridge 已读取该值，并会转换成对应风格提示词。
; ==================================================
PRINTFORM AI 对话设置     [来源：
CALL PRINT_AI_MODEL_SOURCE_NAME
PRINTFORM  / 模型：
CALL PRINT_AI_MODEL_NAME
PRINTFORM  / 回复上限：
CALL PRINT_AI_REPLY_LIMIT_NAME
PRINTFORM  / 记忆容量：
CALL PRINT_AI_MEMORY_LIMIT_NAME
PRINTFORM  / 风格：
CALL PRINT_AI_STYLE_NAME
PRINTL ]

PRINTFORM [8] 模型来源        当前：
CALL PRINT_AI_MODEL_SOURCE_NAME
PRINTL

PRINTFORM      模型名称        当前：
CALL PRINT_AI_MODEL_NAME
PRINTL

PRINTFORM [9] 回复上限        当前：
CALL PRINT_AI_REPLY_LIMIT_NAME
PRINTL

PRINTFORM [10] 记忆容量       当前：
CALL PRINT_AI_MEMORY_LIMIT_NAME
PRINTL

PRINTFORM [11] 对话风格       当前：
CALL PRINT_AI_STYLE_NAME
PRINTL

PRINTL [12] AI 通信测试        当前：调试入口

DRAWLINE
PRINTL [0] 返回标题

$TITLE_SETTING_INPUT
INPUT

SELECTCASE RESULT
    CASE 0
        RETURN

    CASE 1
        CALL TITLE_SETTING_TEXT_COLOR
        GOTO TITLE_SETTING_SELECT

    CASE 2
        CALL TITLE_SETTING_BG_COLOR
        GOTO TITLE_SETTING_SELECT

    CASE 3
        CALL TITLE_SETTING_FONT_NAME
        GOTO TITLE_SETTING_SELECT

    CASE 4
        CALL TITLE_SETTING_FONT_SIZE
        GOTO TITLE_SETTING_SELECT

    CASE 5
        CALL TITLE_SETTING_LINE_HEIGHT
        GOTO TITLE_SETTING_SELECT

    CASE 6
;       自动存档开关
;       自动存档开关。
;       当前已接入雨夜房间：每轮对话结束后判断 GLOBAL:300。
        IF GLOBAL:300 == 1
            GLOBAL:300 = 0
        ELSE
            GLOBAL:300 = 1
        ENDIF
        SAVEGLOBAL
        GOTO TITLE_SETTING_SELECT

    CASE 7
;       返回确认开关
;       返回确认开关。
;       当前已接入退出游戏、剧本选择返回、雨夜房间返回标题。
        IF GLOBAL:301 == 1
            GLOBAL:301 = 0
        ELSE
            GLOBAL:301 = 1
        ENDIF
        SAVEGLOBAL
        GOTO TITLE_SETTING_SELECT

    CASE 8
;       模型来源说明
;       真实后端由 AI/AI_CONFIG.txt 决定。
;       AI Bridge 会写出 AI/model_source.txt 和 AI/model_name.txt 供设置页显示。
        CALL TITLE_SETTING_AI_MODEL_INFO
        GOTO TITLE_SETTING_SELECT


    CASE 9
;       回复上限 Token 设置
;       点进去说明后手动输入。
;       当前保存的数值已经会写入 AI 请求，并由 AI Bridge 用于控制回复上限。
        CALL TITLE_SETTING_AI_REPLY_LIMIT
        GOTO TITLE_SETTING_SELECT

    CASE 10
;       记忆容量 Token 设置
;       点进去说明后手动输入。
;       当前保存的数值已经会写入 AI 请求。
;       长期记忆库已由 AI Bridge 接入，保存在游戏根目录 cache 文件夹中。
        CALL TITLE_SETTING_AI_MEMORY_LIMIT
        GOTO TITLE_SETTING_SELECT

    CASE 11
;       对话风格设置
;       点进去选择具体风格。
;       当前保存的风格已经会写入 AI 请求，并由 AI Bridge 转换成风格提示词。
        CALL TITLE_SETTING_AI_STYLE
        GOTO TITLE_SETTING_SELECT

    CASE 12
;       AI 通信测试
;       AI 通信测试。
;       当前已经支持：玩家输入 → 写入请求 → AI Bridge 自动处理 → 读取回复。
;       正式剧本对话入口已经在“雨夜房间”中接入。
        CALL TITLE_SETTING_AI_TEST
        GOTO TITLE_SETTING_SELECT

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_SETTING_INPUT
ENDSELECT



; ==================================================
; 显示设置初始化
; GLOBAL:200 文本颜色  0默认 1柔和白 2淡青色 3暖白色 4自定义RGB
; GLOBAL:201 背景颜色  0默认 1深色 2蓝黑色 3自定义RGB
; GLOBAL:210 文本颜色R
; GLOBAL:211 文本颜色G
; GLOBAL:212 文本颜色B
; GLOBAL:220 背景颜色R
; GLOBAL:221 背景颜色G
; GLOBAL:222 背景颜色B
;
; 游戏设置：
; GLOBAL:300 自动存档  0关 1开
;   当前已经接入主流程。雨夜房间对话结束后会调用 GAME_AUTOSAVE。
;
; GLOBAL:301 返回确认  0关 1开
;   当前已经接入退出游戏、剧本选择返回、雨夜房间返回标题等流程。
;
; AI 对话设置：
; GLOBAL:400 模型来源  0本地 1外部服务
;   游戏内不直接切换真实后端。真实后端由 AI/AI_CONFIG.txt 决定。
;
; GLOBAL:401 模型名称状态
;   当前由 AI/model_name.txt 显示真实模型名称。
;
; GLOBAL:402 回复上限 Token
;   当前已经写入请求，并由 AI Bridge 用于 max_tokens。
;
; GLOBAL:403 记忆容量 Token
;   当前已经写入请求，并由 AI Bridge 用于控制长期记忆读取上限。
;
; GLOBAL:404 对话风格
;   当前已经写入请求，并由 AI Bridge 转换成风格提示词。
;
; 初始化标记：
; GLOBAL:900 显示设置初始化标记
; GLOBAL:901 自动存档初始化标记
; GLOBAL:902 返回确认初始化标记
; GLOBAL:904 AI设置初始化标记
; ==================================================
@INIT_DISPLAY_SETTINGS

IF GLOBAL:900 == 0
    GLOBAL:200 = 0
    GLOBAL:201 = 0

    GLOBAL:210 = 245
    GLOBAL:211 = 235
    GLOBAL:212 = 220

    GLOBAL:220 = 15
    GLOBAL:221 = 15
    GLOBAL:222 = 18

    GLOBAL:900 = 1
    SAVEGLOBAL
ENDIF

IF GLOBAL:901 == 0
;   默认开启自动存档开关。
;   注意：这里还不会真正自动保存，只是设置默认状态。
    GLOBAL:300 = 1
    GLOBAL:901 = 1
    SAVEGLOBAL
ENDIF

IF GLOBAL:902 == 0
;   默认开启返回确认开关。
;   注意：这里还不会真正弹出确认，只是设置默认状态。
    GLOBAL:301 = 1
    GLOBAL:902 = 1
    SAVEGLOBAL
ENDIF

IF GLOBAL:904 == 0
;   默认初始化 AI 对话设置。
;   注意：这里还不会真正调用 AI，只是设置默认状态。
    GLOBAL:400 = 0
    GLOBAL:401 = 0
    GLOBAL:402 = 512
    GLOBAL:403 = 1024
    GLOBAL:404 = 0

    GLOBAL:904 = 1
    SAVEGLOBAL
ENDIF

RETURN



; ==================================================
; 应用显示设置
; ==================================================
@APPLY_DISPLAY_SETTINGS

; 背景颜色
SELECTCASE GLOBAL:201
    CASE 0
        RESETBGCOLOR

    CASE 1
        SETBGCOLOR 15, 15, 18

    CASE 2
        SETBGCOLOR 10, 18, 30

    CASE 3
        SETBGCOLOR GLOBAL:220, GLOBAL:221, GLOBAL:222

    CASEELSE
        RESETBGCOLOR
ENDSELECT

; 文本颜色
SELECTCASE GLOBAL:200
    CASE 0
        RESETCOLOR

    CASE 1
        SETCOLOR 220, 220, 220

    CASE 2
        SETCOLOR 180, 240, 255

    CASE 3
        SETCOLOR 245, 235, 220

    CASE 4
        SETCOLOR GLOBAL:210, GLOBAL:211, GLOBAL:212

    CASEELSE
        RESETCOLOR
ENDSELECT

RETURN



; ==================================================
; 文本颜色名称显示
; ==================================================
@PRINT_TEXT_COLOR_NAME

SELECTCASE GLOBAL:200
    CASE 0
        PRINTFORM 默认

    CASE 1
        PRINTFORM 柔和白

    CASE 2
        PRINTFORM 淡青色

    CASE 3
        PRINTFORM 暖白色

    CASE 4
        PRINTFORM 自定义RGB({GLOBAL:210},{GLOBAL:211},{GLOBAL:212})

    CASEELSE
        PRINTFORM 默认
ENDSELECT

RETURN



; ==================================================
; 背景颜色名称显示
; ==================================================
@PRINT_BG_COLOR_NAME

SELECTCASE GLOBAL:201
    CASE 0
        PRINTFORM 默认

    CASE 1
        PRINTFORM 深色

    CASE 2
        PRINTFORM 蓝黑色

    CASE 3
        PRINTFORM 自定义RGB({GLOBAL:220},{GLOBAL:221},{GLOBAL:222})

    CASEELSE
        PRINTFORM 默认
ENDSELECT

RETURN



; ==================================================
; 自动存档状态显示
; ==================================================
@PRINT_AUTOSAVE_NAME

IF GLOBAL:300 == 1
    PRINTFORM 开
ELSE
    PRINTFORM 关
ENDIF

RETURN



; ==================================================
; 返回确认状态显示
; ==================================================
@PRINT_RETURN_CONFIRM_NAME

IF GLOBAL:301 == 1
    PRINTFORM 开
ELSE
    PRINTFORM 关
ENDIF

RETURN



; ==================================================
; AI 模型来源显示
; ==================================================
@PRINT_AI_MODEL_SOURCE_NAME

; 优先读取 AI Bridge 写出的真实模型来源。
LOADTEXT "AI/model_source.txt", 0, 1

IF RESULTS:0 != ""
    PRINTFORM %RESULTS:0%
    RETURN
ENDIF

; 如果 AI Bridge 尚未启动，回退显示界面默认分类。
SELECTCASE GLOBAL:400
    CASE 0
        PRINTFORM 本地
    CASE 1
        PRINTFORM 外部服务
    CASEELSE
        PRINTFORM 未读取
ENDSELECT

RETURN



; ==================================================
; AI 模型名称显示
; ==================================================
@PRINT_AI_MODEL_NAME

; 优先读取 AI Bridge 写出的真实模型名称。
LOADTEXT "AI/model_name.txt", 0, 1

IF RESULTS:0 != ""
    PRINTFORM %RESULTS:0%
    RETURN
ENDIF

PRINTFORM 未读取

RETURN



