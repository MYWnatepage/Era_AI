; ==================================================
; 输入、发送并自动读取 AI 测试请求
; ==================================================
@AI_SEND_TEST_REQUEST

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 输入 AI 测试请求 / Send Request
ALIGNMENT LEFT
DRAWLINE
PRINTL 请输入要发送给 AI 的测试文本。
PRINTL
PRINTL 示例：
PRINTL   你是谁？
PRINTL   请扮演一个冷淡的女仆，用一句话欢迎玩家回家。
PRINTL   请用温柔的语气回应：我回来了。
DRAWLINE
PRINTL 注意：
PRINTL   当前测试版暂不建议在输入内容中使用 | 符号。
PRINTL   因为 | 会被 ai_bridge.py 当作字段分隔符。
DRAWLINE

$AI_SEND_TEST_REQUEST_TEXT_INPUT
INPUTS
LOCALS:1 '= RESULTS:0

IF LOCALS:1 == ""
    DRAWLINE
    PRINTL 输入为空，本次没有写入请求。
    DRAWLINE
    PRINTL [0] 返回 AI 通信测试页面

    $AI_SEND_TEST_REQUEST_EMPTY_INPUT
    INPUT
    IF RESULT == 0
        RETURN
    ELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请输入 0 返回。
        GOTO AI_SEND_TEST_REQUEST_EMPTY_INPUT
    ENDIF
ENDIF

; 写入格式说明：
;   PROMPT              本次要发送给 AI 的正文
;   REPLY_LIMIT         回复上限 Token，对应 GLOBAL:402
;   MEMORY_LIMIT        记忆容量 Token，对应 GLOBAL:403
;   MODEL_SOURCE_CODE   模型来源编号，对应 GLOBAL:400，0本地 1外部服务
;   STYLE_CODE          对话风格编号，对应 GLOBAL:404
;
; 注意：
;   这里必须使用字符串表达式赋值符号 '= 。
;   STRFORM 用于把玩家输入和当前设置拼成结构化请求。
LOCALS:0 '= STRFORM("PROMPT=%LOCALS:1%|REPLY_LIMIT={GLOBAL:402}|MEMORY_LIMIT={GLOBAL:403}|MODEL_SOURCE_CODE={GLOBAL:400}|STYLE_CODE={GLOBAL:404}")

; 先把回复文件写成等待状态，避免立刻读取到上一条旧回复。
SAVETEXT "【等待中】AI 请求已发送，正在等待 AI Bridge 生成回复。", "AI/ai_response.txt", 0, 1

; 再写入请求文件。AI Bridge 监听到文件变化后会自动处理。
SAVETEXT LOCALS:0, "AI/ai_request.txt", 0, 1

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL AI 请求已发送 / Waiting
ALIGNMENT LEFT
DRAWLINE
PRINTL 已写入请求到：AI/ai_request.txt
PRINTL 已将回复状态临时设置为：等待中
DRAWLINE
PRINTL 当前请求内容为：
PRINTFORML %LOCALS:0%
DRAWLINE
PRINTFORM 当前模型来源：
CALL PRINT_AI_MODEL_SOURCE_NAME
PRINTL
PRINTFORM 当前回复上限：
CALL PRINT_AI_REPLY_LIMIT_NAME
PRINTL
PRINTFORM 当前记忆容量：
CALL PRINT_AI_MEMORY_LIMIT_NAME
PRINTL
PRINTFORM 当前对话风格：
CALL PRINT_AI_STYLE_NAME
PRINTL
DRAWLINE
PRINTL 正在等待 AI Bridge 处理请求……
PRINTL 如果 GX 模型服务较慢，可以稍后选择 [1] 再读取一次。
DRAWLINE

; 等待 4 秒后自动读取回复。
; TWAIT 第一参数为等待时间，第二参数为输入接收标志。
; 第二参数为 1 时，不接受输入，强制等待到时间结束。
TWAIT 4000, 1

CALL AI_AUTO_READ_TEST_RESPONSE
RETURN



