@LOAD_SCENARIO_SELECT
CALL SCENARIO_MENU, 1
RETURN

@CHECK_SCENARIO_SAVE, ARG, ARGS:0
LOCAL = CHKDATA(ARG)
IF LOCAL != 0
    RETURN 0
ENDIF
RESULTS:1 '= ARGS:0
AICONNECTION 48
RETURN RESULT

@LOAD_SCENARIO_SAVES, ARGS:0
#DIMS TARGET_ID
#DIMS TARGET_NAME
#DIM PAGE
#DIM SLOT
#DIM FOUND
TARGET_ID '= ARGS:0
RESULTS:0 '= TARGET_ID
AICONNECTION 47
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
TARGET_NAME '= RESULTS:1
PAGE = 0
$SCENARIO_SAVE_PAGE
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTFORML %TARGET_NAME% · 读取存档
ALIGNMENT LEFT
DRAWLINE
PRINTFORML 手动存档 · 第 {PAGE + 1} / 5 页
FOUND = 0
FOR SLOT, PAGE * 20, MIN(PAGE * 20 + 20, 99)
    CALL CHECK_SCENARIO_SAVE, SLOT, TARGET_ID
    IF RESULT == 1
        PRINTFORML [{SLOT + 1}] 存档 {SLOT}：%RESULTS:0%
        FOUND += 1
    ENDIF
NEXT
IF FOUND == 0
    PRINTL 本页暂无该剧本的手动存档。
ENDIF
DRAWLINE
CALL CHECK_SCENARIO_SAVE, 99, TARGET_ID
IF RESULT == 1
    PRINTFORML [100] 自动存档：%RESULTS:0%
ELSE
    PRINTL 暂无该剧本的自动存档。
ENDIF
DRAWLINE
IF PAGE > 0
    PRINTL [1001] 上一页
ENDIF
IF PAGE < 4
    PRINTL [1002] 下一页
ENDIF
PRINTL [0] 返回上一级
REDRAW 1
ESCAPE 0
INPUT
SLOT = RESULT
SELECTCASE SLOT
    CASE 0
        RETURN
    CASE 1001
        PAGE = MAX(0, PAGE - 1)
        GOTO SCENARIO_SAVE_PAGE
    CASE 1002
        PAGE = MIN(4, PAGE + 1)
        GOTO SCENARIO_SAVE_PAGE
ENDSELECT
IF SLOT < 1 || SLOT > 100
    GOTO SCENARIO_SAVE_PAGE
ENDIF
SLOT -= 1
CALL CHECK_SCENARIO_SAVE, SLOT, TARGET_ID
IF RESULT != 1
    PRINTL 该存档不存在、无法读取或不属于此剧本。
    WAIT
    GOTO SCENARIO_SAVE_PAGE
ENDIF
LOADDATA SLOT
RETURN

@EVENTLOAD
#DIM TOTAL
#DIM MATCHES
#DIMS LEGACY_ID
#DIMS PROBE
; Explicit saved IDs take precedence. Blank IDs use each package's migration probe.
IF SAVESTR:0 == ""
    RESULT = 0
    AICONNECTION 46
    TOTAL = MAX(0, RESULT)
    MATCHES = 0
    FOR LOCAL:90, 0, TOTAL
        RESULT = LOCAL:90
        AICONNECTION 49
        LEGACY_ID '= RESULTS:0
        PROBE '= RESULTS:9
        IF PROBE != ""
            CALLFORM %PROBE%
            IF RESULT == 1
                MATCHES += 1
                LOCALS:90 '= LEGACY_ID
            ENDIF
        ENDIF
    NEXT
    IF MATCHES == 1
        SAVESTR:0 '= LOCALS:90
    ENDIF
ENDIF
RESULTS:0 '= SAVESTR:0
AICONNECTION 47
IF RESULT < 0
    PRINTL 无法识别存档所属剧本，请检查该剧本是否已安装且登记有效。
    WAIT
    BEGIN TITLE
ENDIF
CALL SCENARIO_CALL_HOOK, 6
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    BEGIN TITLE
ENDIF
CALL SCENARIO_CALL_HOOK, 3
BEGIN TITLE
