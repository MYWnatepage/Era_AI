@LOAD_SCENARIO_SELECT
$LOAD_SCENARIO_PAGE
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTL 读取存档 · 选择剧本
ALIGNMENT LEFT
DRAWLINE
PRINTL 请选择要读取进度的剧本。
DRAWLINE
PRINTL [1] 雨夜房间        作者：Natepage
PRINTL [0] 返回标题
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        CALL LOAD_RAIN_ROOM_SAVES
        GOTO LOAD_SCENARIO_PAGE
    CASEELSE
        GOTO LOAD_SCENARIO_PAGE
ENDSELECT
RETURN

@CHECK_RAIN_ROOM_SAVE(ARG)
LOCAL = CHKDATA(ARG)
IF LOCAL != 0
    RETURN 0
ENDIF
IF STRFIND(RESULTS, "雨夜房间") < 0
    RETURN 0
ENDIF
RETURN 1

@LOAD_RAIN_ROOM_SAVES
#DIM PAGE
#DIM SLOT
#DIM FOUND
PAGE = 0
$RAIN_ROOM_SAVE_PAGE
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTL 雨夜房间 · 读取存档
ALIGNMENT LEFT
DRAWLINE
PRINTFORML 手动存档 · 第 {PAGE + 1} / 5 页
FOUND = 0
FOR SLOT, PAGE * 20, MIN(PAGE * 20 + 20, 99)
    CALL CHECK_RAIN_ROOM_SAVE(SLOT)
    IF RESULT == 1
        PRINTFORML [{SLOT + 1}] 存档 {SLOT}：%RESULTS%
        FOUND += 1
    ENDIF
NEXT
IF FOUND == 0
    PRINTL 本页暂无该剧本的手动存档。
ENDIF
DRAWLINE
CALL CHECK_RAIN_ROOM_SAVE(99)
IF RESULT == 1
    PRINTFORML [100] 自动存档：%RESULTS%
ELSE
    PRINTL 暂无该剧本的自动存档。
ENDIF
DRAWLINE
IF PAGE > 0
    PRINTL [1001] 上一页
ENDIF
IF PAGE < 4
    PRINTL [1002] 下一页
ENDIF
PRINTL [0] 返回上一级
REDRAW 1
ESCAPE 0
INPUT
SLOT = RESULT
SELECTCASE SLOT
    CASE 0
        RETURN
    CASE 1001
        IF PAGE > 0
            PAGE -= 1
        ENDIF
        GOTO RAIN_ROOM_SAVE_PAGE
    CASE 1002
        IF PAGE < 4
            PAGE += 1
        ENDIF
        GOTO RAIN_ROOM_SAVE_PAGE
ENDSELECT
IF SLOT < 1 || SLOT > 100
    GOTO RAIN_ROOM_SAVE_PAGE
ENDIF
SLOT -= 1
CALL CHECK_RAIN_ROOM_SAVE(SLOT)
IF RESULT != 1
    PRINTL 该存档不存在、无法读取或不属于此剧本。
    WAIT
    GOTO RAIN_ROOM_SAVE_PAGE
ENDIF
LOADDATA SLOT
RETURN

@EVENTLOAD
IF (SAVESTR:0 != "" && SAVESTR:0 != "rain_room") || (SAVESTR:0 == "" && FLAG:2 != 1)
    PRINTL 无法识别存档所属剧本，请选择其他存档。
    WAIT
    BEGIN TITLE
ENDIF
GLOBAL:500 = 1
GLOBAL:501 = 0
GLOBAL:502 = 0
GLOBAL:503 = 1
GLOBAL:510 = 0
FOR LOCAL, 25, 53, 3
    IF SAVESTR:LOCAL != ""
        GLOBAL:510 += 1
    ENDIF
NEXT
SAVESTR:0 '= "rain_room"
CALL RESTORE_RAIN_ROOM_AI_HISTORY
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    BEGIN TITLE
ENDIF
SAVEGLOBAL
CALL SCENARIO_TEST_RAIN_ROOM_START
BEGIN TITLE
