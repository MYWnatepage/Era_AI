@SETTING_SUMMARY, ARGS:0, ARGS:1
LOCALS:99 '= ARGS:0 + "     [" + ARGS:1 + "]"
IF HTML_STRINGLEN(HTML_ESCAPE(LOCALS:99), 1) <= CLIENTWIDTH() - 24
    PRINTFORML %LOCALS:99%
    RETURN
ENDIF
PRINTFORML %ARGS:0%
SPLIT ARGS:1, " / ", LOCALS, LOCAL:0
LOCALS:90 '= "["
FOR LOCAL:1, 0, LOCAL:0
    LOCALS:91 '= LOCALS:90
    IF LOCAL:1 > 0
        LOCALS:91 += " / "
    ENDIF
    LOCALS:91 += LOCALS:(LOCAL:1)
    IF HTML_STRINGLEN(HTML_ESCAPE(LOCALS:91 + "]"), 1) > CLIENTWIDTH() - 24 && LOCALS:90 != "["
        PRINTFORML %LOCALS:90%
        LOCALS:90 '= "　" + LOCALS:(LOCAL:1)
    ELSE
        LOCALS:90 '= LOCALS:91
    ENDIF
NEXT
PRINTFORML %LOCALS:90%]
RETURN
