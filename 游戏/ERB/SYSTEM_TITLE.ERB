@MODEL_CHOOSE_REMOTE
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 读取服务模型列表
DRAWLINE
PRINTL 正在读取，按 Esc 取消。
AICONNECTION 8
IF RESULT < 0
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
$MODEL_LIST_WAIT
TWAIT 100, 1
AICONNECTION 11
IF RESULT == 0
    GOTO MODEL_LIST_WAIT
ENDIF
IF RESULT < 0
    IF RESULTS:0 != "本次请求已取消。"
        CALL MODEL_CONNECTION_ERROR
    ENDIF
    RETURN
ENDIF
LOCAL:0 = 0
$MODEL_LIST_PAGE
REDRAW 0
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 选择模型
DRAWLINE
RESULT = LOCAL:0
AICONNECTION 13
IF RESULT < 0
    REDRAW 1
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
LOCAL:1 = RESULT
DRAWLINE
PRINTFORML 第 {LOCAL:0 + 1} 页，共 {(LOCAL:1 + 19) / 20} 页
IF LOCAL:0 > 0
    PRINTL [100001] 上一页
ENDIF
IF (LOCAL:0 + 1) * 20 < LOCAL:1
    PRINTL [100002] 下一页
ENDIF
PRINTL [0] 返回模型连接设置
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 100001
        IF LOCAL:0 > 0
            LOCAL:0 -= 1
        ENDIF
        GOTO MODEL_LIST_PAGE
    CASE 100002
        IF (LOCAL:0 + 1) * 20 < LOCAL:1
            LOCAL:0 += 1
        ENDIF
        GOTO MODEL_LIST_PAGE
    CASEELSE
        AICONNECTION 12
        IF RESULT < 0
            CALL MODEL_CONNECTION_ERROR
            GOTO MODEL_LIST_PAGE
        ENDIF
        RETURN
ENDSELECT
RETURN

@MODEL_SELECT_SERVICE
$MODEL_SERVICE_PAGE
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
AICONNECTION 0
DRAWLINE
PRINTL 服务地址
DRAWLINE
PRINTFORML 当前：%RESULTS:2%
PRINTL [1] DeepSeek
PRINTL [2] Gemini（Google）
PRINTL [3] Grok（xAI）
PRINTL [4] GPT（OpenAI）
PRINTL [5] 自定义地址
DRAWLINE
PRINTL 切换不同平台后，需要重新填写对应密钥并读取模型。
PRINTL [0] 返回模型连接设置
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        RESULTS:0 '= "https://api.deepseek.com"
    CASE 2
        RESULTS:0 '= "https://generativelanguage.googleapis.com/v1beta/openai"
    CASE 3
        RESULTS:0 '= "https://api.x.ai/v1"
    CASE 4
        RESULTS:0 '= "https://api.openai.com/v1"
    CASE 5
        PRINTL 请输入服务根地址，留空或按 Esc 取消。
        INPUTS
        IF RESULTS:0 == ""
            GOTO MODEL_SERVICE_PAGE
        ENDIF
    CASEELSE
        GOTO MODEL_SERVICE_PAGE
ENDSELECT
AICONNECTION 3
CALL MODEL_CONNECTION_ERROR
RETURN


@MODEL_CONNECTION_TUTORIAL
