@SYSTEM_TITLE

$TITLE_SELECT

REDRAW 0
LOADGLOBAL
CALL INIT_DISPLAY_SETTINGS
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
DRAWLINE
ALIGNMENT CENTER
PRINTFORML ◇ %GAMEBASE_TITLE% ◇
PRINTL
PRINTL —— 文字冒险系统 ——
PRINTL
PRINTFORML 版本：%GAMEBASE_VERSIONNAME%
PRINTL
PRINTFORML 创作者：%GAMEBASE_AUTHOR%
ALIGNMENT LEFT
DRAWLINE
DRAWLINE

PRINTL                [0] 开始新游戏　　[从第一天开始，进入新的故事流程]
PRINTL                [1] 读取存档　　　[载入已有进度，继续上次的游戏]
PRINTL                [2] 游戏说明　　　[查看基础玩法、配置要求、更新内容]
PRINTL                [3] 设置　　　　　[调整显示、系统流程、AI相关选项]
PRINTL                [4] 关于　　　　　[查看项目版本、制作信息、开发目标]
PRINTL                [9] 退出游戏　　　[关闭程序并返回桌面]

$TITLE_INPUT
ESCAPE -1
INPUT

SELECTCASE RESULT
    CASE 0
        DRAWLINE
        RESETDATA
        BEGIN FIRST

    CASE 1
	CLEARLINE LINECOUNT
        CALL LOAD_SCENARIO_SELECT
        GOTO TITLE_SELECT

    CASE 2
        CALL TITLE_HELP
        GOTO TITLE_SELECT

    CASE 3
        CALL TITLE_SETTING
        GOTO TITLE_SELECT

    CASE 4
        CALL TITLE_ABOUT
        GOTO TITLE_SELECT

    CASE 9
        CALL TITLE_EXIT_CONFIRM
        GOTO TITLE_SELECT

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_INPUT
ENDSELECT

@TITLE_HELP

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 游戏说明
ALIGNMENT LEFT
DRAWLINE
PRINTL   本项目是一款 AI 文字冒险游戏，通过对话和选择推进故事。
DRAWLINE
PRINTL 通用环境
PRINTL   ・Windows 10 / 11（64 位），运行所需组件已随游戏附带。
PRINTL   ・双击 EraAI.exe 启动，在“设置 → 模型连接设置”中配置模型。
DRAWLINE
PRINTL 方式一：API 接入（配置要求较低）
PRINTL   ・配置参考：普通四核处理器、8GB 内存，集成显卡即可。
PRINTL   ・填写兼容服务的地址、模型名称和 API 密钥，在游戏内选择对应方式。
PRINTL   ・需要稳定联网，可能产生调用费用；请妥善保管密钥。
DRAWLINE
PRINTL 方式二：本地大模型（配置要求较高）
PRINTL   ・入门参考：6 核 12 线程、32GB 内存、8GB 显存，额外预留 50GB 空间。
PRINTL   ・进阶参考：64GB 内存、16GB 及以上显存，额外预留 100GB 空间。
PRINTL   ・先下载模型并启动兼容的本地服务，再填写服务地址和模型名称。
PRINTL   ・以上适用于选型参考，实际需求取决于模型大小、量化方式和上下文长度。
DRAWLINE
PRINTL [0] 返回标题

$TITLE_HELP_INPUT
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSE
    CLEARLINE 1
    REUSELASTLINE 输入无效，请输入 0 返回标题。
    GOTO TITLE_HELP_INPUT
ENDIF

@TITLE_SETTING

$TITLE_SETTING_SELECT

REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 设置
ALIGNMENT LEFT
DRAWLINE
PRINTL 本页面用于管理游戏显示、系统流程和 AI 对话等相关选项。
DRAWLINE

DISPLAYINFO
CALL SETTING_SUMMARY, "显示设置", STRFORM("文本：%RESULTS:0% / 背景：%RESULTS:1% / 焦点：%RESULTS:2% / 字体：%RESULTS:3% / 字号：%RESULTS:4% / 行距：%RESULTS:5%")
PRINTFORML [1] 文本颜色        当前：%RESULTS:0%
PRINTFORML [2] 背景颜色        当前：%RESULTS:1%
PRINTFORML [3] 焦点颜色        当前：%RESULTS:2%
PRINTFORML [4] 字体样式        当前：%RESULTS:3%
PRINTFORML [5] 字体大小        当前：%RESULTS:4%
PRINTFORML [6] 行距设置        当前：%RESULTS:5%

DRAWLINE
LOCALS:20 '= "关"
LOCALS:21 '= "关"
IF GLOBAL:300 == 1
    LOCALS:20 '= "开"
ENDIF
IF GLOBAL:301 == 1
    LOCALS:21 '= "开"
ENDIF
CALL SETTING_SUMMARY, "游戏设置", STRFORM("自动存档：%LOCALS:20% / 返回确认：%LOCALS:21%")

PRINTFORM [7] 自动存档        当前：
CALL PRINT_AUTOSAVE_NAME
PRINTL

PRINTFORM [8] 返回确认        当前：
CALL PRINT_RETURN_CONFIRM_NAME
PRINTL

DRAWLINE
AIINFO
CALL SETTING_SUMMARY, "AI 模型设置", STRFORM("来源：%RESULTS:1% / 模型：%RESULTS:0%")
PRINTL [9] 模型连接设置
DRAWLINE
AIGENERATION 0
IF RESULT < 0
    PRINTL AI 生成设置
    PRINTFORML %RESULTS:0%
ELSE
    LOCALS:10 '= RESULTS:1
    IF STRFIND(RESULTS:1, "自动") == 0
        LOCALS:10 '= "自动"
    ENDIF
    LOCALS:11 '= "手动"
    IF STRFIND(RESULTS:12, "自动") == 0
        LOCALS:11 '= "自动"
    ENDIF
    CALL SETTING_SUMMARY, "AI 生成设置", STRFORM("采样：%RESULTS:0% / 回复：%RESULTS:11% / 预算：%LOCALS:10% / 上下文：%LOCALS:11% / 历史：%RESULTS:3% 轮 / 思考：%RESULTS:8%")
    PRINTFORML [10] 采样设置%"　"%  当前：%RESULTS:0% / %RESULTS:14%
    PRINTFORML [11] 回复长度%"　"%  当前：%RESULTS:11% / 预算：%RESULTS:1%
    PRINTFORML [12] 上下文管理  当前：%RESULTS:12% / 历史 %RESULTS:3% 轮
    PRINTFORML [13] 思考模式%"　"%  当前：%RESULTS:8%
ENDIF

DRAWLINE
PRINTL [0] 返回标题

REDRAW 1
$TITLE_SETTING_INPUT
ESCAPE 0
INPUT

SELECTCASE RESULT
    CASE 0
        RETURN

    CASE 1
        CALL TITLE_SETTING_TEXT_COLOR
        GOTO TITLE_SETTING_SELECT

    CASE 2
        CALL TITLE_SETTING_BG_COLOR
        GOTO TITLE_SETTING_SELECT

    CASE 3
        CALL EDIT_DISPLAY_COLOR, 2
        GOTO TITLE_SETTING_SELECT

    CASE 4
        CALL TITLE_SETTING_FONT_NAME
        GOTO TITLE_SETTING_SELECT

    CASE 5
        CALL TITLE_SETTING_FONT_SIZE
        GOTO TITLE_SETTING_SELECT

    CASE 6
        CALL TITLE_SETTING_LINE_HEIGHT
        GOTO TITLE_SETTING_SELECT

    CASE 7
        IF GLOBAL:300 == 1
            GLOBAL:300 = 0
        ELSE
            GLOBAL:300 = 1
        ENDIF
        SAVEGLOBAL
        GOTO TITLE_SETTING_SELECT

    CASE 8
        IF GLOBAL:301 == 1
            GLOBAL:301 = 0
        ELSE
            GLOBAL:301 = 1
        ENDIF
        SAVEGLOBAL
        GOTO TITLE_SETTING_SELECT

    CASE 9
        CALL TITLE_SETTING_AI_MODEL_INFO
        GOTO TITLE_SETTING_SELECT

    CASE 10
        CALL GENERATION_SAMPLING_PAGE
        GOTO TITLE_SETTING_SELECT
    CASE 11
        CALL GENERATION_LENGTH_PAGE
        GOTO TITLE_SETTING_SELECT
    CASE 12
        CALL GENERATION_CONTEXT_PAGE
        GOTO TITLE_SETTING_SELECT
    CASE 13
        CALL GENERATION_THINKING_PAGE
        GOTO TITLE_SETTING_SELECT

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_SETTING_INPUT
ENDSELECT

