; 主菜单与退出确认。页面入口在对应的 SYSTEM_*.ERB 文件中。

@SYSTEM_TITLE

$TITLE_SELECT

REDRAW 0
LOADGLOBAL
CALL INIT_DISPLAY_SETTINGS
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
DRAWLINE
ALIGNMENT CENTER
PRINTFORML ◇ %GAMEBASE_TITLE% ◇
PRINTL
PRINTL —— 文字冒险系统 ——
PRINTL
PRINTFORML 版本：%GAMEBASE_VERSIONNAME%
PRINTL
PRINTFORML 创作者：%GAMEBASE_AUTHOR%
ALIGNMENT LEFT
DRAWLINE
DRAWLINE

PRINTL                [0] 开始新游戏　　[从第一天开始，进入新的故事流程]
PRINTL                [1] 读取存档　　　[载入已有进度，继续上次的游戏]
PRINTL                [2] 游戏说明　　　[查看软件简介、运行环境与接入要求]
PRINTL                [3] 设置　　　　　[调整显示、系统流程、AI相关选项]
PRINTL                [4] 关于　　　　　[查看项目版本、制作信息、开发目标]
PRINTL                [9] 退出游戏　　　[关闭程序并返回桌面]

$TITLE_INPUT
ESCAPE -1
INPUT

SELECTCASE RESULT
    CASE 0
        DRAWLINE
        RESETDATA
        BEGIN FIRST

    CASE 1
	CLEARLINE LINECOUNT
        CALL LOAD_SCENARIO_SELECT
        GOTO TITLE_SELECT

    CASE 2
        CALL TITLE_HELP
        GOTO TITLE_SELECT

    CASE 3
        CALL TITLE_SETTING
        GOTO TITLE_SELECT

    CASE 4
        CALL TITLE_ABOUT
        GOTO TITLE_SELECT

    CASE 9
        CALL TITLE_EXIT_CONFIRM
        GOTO TITLE_SELECT

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_INPUT
ENDSELECT

@TITLE_EXIT_CONFIRM

IF GLOBAL:301 == 0
    QUIT
ENDIF

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 退出确认
ALIGNMENT LEFT
DRAWLINE
PRINTL 当前已开启“返回确认”。
PRINTL 确定要退出游戏吗？
DRAWLINE
PRINTL [1] 确定退出
PRINTL [0] 取消，返回标题

$TITLE_EXIT_CONFIRM_INPUT
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 1
        QUIT

    CASE 0
        RETURN

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_EXIT_CONFIRM_INPUT
ENDSELECT
