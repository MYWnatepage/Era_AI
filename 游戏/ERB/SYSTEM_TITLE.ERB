@TITLE_SETTING_AI_TEST
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 模型连接测试
DRAWLINE
PRINTL 正在请求当前模型，按 Esc 取消。
AISTART "请用一句简体中文回复：连接成功。", "连接测试", "connection_test", "", 64, 0, "简洁"
IF RESULT != 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
$NATIVE_TEST_WAIT
TWAIT 100, 1
AIPOLL
IF RESULT == 0
    GOTO NATIVE_TEST_WAIT
ENDIF
IF RESULTS:0 == "本次请求已取消。"
    RETURN
ENDIF
PRINTFORML %RESULTS:0%
WAIT
RETURN

