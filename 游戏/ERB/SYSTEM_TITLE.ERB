@TITLE_SETTING_AI_MODEL_INFO
$MODEL_CONNECTION_PAGE
AICONNECTION 14
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
AICONNECTION 0
LOCAL:19 = RESULT
DRAWLINE
ALIGNMENT CENTER
PRINTL 模型连接设置
ALIGNMENT LEFT
DRAWLINE
PRINTFORML [1] 接入方式        当前：%RESULTS:1%
PRINTFORML [2] 服务地址        当前：%RESULTS:2%
PRINTFORML [3] 选择模型        当前：%RESULTS:0%
PRINTFORML [4] API 密钥        当前：%RESULTS:3%
PRINTFORML [5] 等待超时        当前：%RESULTS:4% 秒
IF LOCAL:19 == 1
    DRAWLINE
    AICONNECTION 16
    PRINTFORML 账户余额：%RESULTS:0%
    PRINTFORML 今日花费（本游戏，估算）：%RESULTS:1%
    PRINTFORML 今日用量（本游戏）：%RESULTS:2%
    PRINTL 包含连接测试；仅计已返回用量，取消或异常请求可能未计入。按北京时间每日累计。
    PRINTL [6] 查看近7日消耗折线图
ENDIF
DRAWLINE
AICONNECTION 0
CALL MODEL_CONNECTION_TUTORIAL
DRAWLINE
IF LOCAL:19 == 1
    PRINTL [7] 测试当前连接
    PRINTL [8] 清除当前密钥
    PRINTL [9] 刷新账户信息
ELSE
    PRINTL [6] 测试当前连接
    PRINTL [7] 清除当前密钥
ENDIF
PRINTL [0] 返回设置
REDRAW 1
$MODEL_ACCOUNT_WAIT
IF LOCAL:19 == 1
    AICONNECTION 15
    IF RESULT == 0
        ESCAPE 0
        TWAIT 100, 1
        GOTO MODEL_ACCOUNT_WAIT
    ELSEIF RESULT == 2
        GOTO MODEL_CONNECTION_PAGE
    ELSEIF RESULT == 3
        RETURN
    ENDIF
ENDIF
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        CALL MODEL_SELECT_SOURCE
    CASE 2
        CALL MODEL_SELECT_SERVICE
    CASE 3
        CALL MODEL_CHOOSE_REMOTE
    CASE 4
        PRINTL 请输入密钥，输入内容将隐藏；留空或按 Esc 取消。
        AICONNECTION 9
        INPUTS
        AICONNECTION 10
        AICONNECTION 5
        CALL MODEL_CONNECTION_ERROR
    CASE 5
        PRINTL 请输入等待超时秒数（10～600），留空或按 Esc 取消。
        INPUTS
        AICONNECTION 6
        CALL MODEL_CONNECTION_ERROR
    CASE 6
        IF LOCAL:19 == 1
            CALL MODEL_USAGE_CHART
        ELSE
            CALL TITLE_SETTING_AI_TEST
        ENDIF
    CASE 7
        IF LOCAL:19 == 1
            CALL TITLE_SETTING_AI_TEST
        ELSE
            CALL MODEL_CLEAR_KEY
        ENDIF
    CASE 8
        IF LOCAL:19 == 1
            CALL MODEL_CLEAR_KEY
        ENDIF
    CASE 9
        IF LOCAL:19 == 1
            AICONNECTION 17
        ENDIF
    CASEELSE
        GOTO MODEL_CONNECTION_PAGE
ENDSELECT
GOTO MODEL_CONNECTION_PAGE
RETURN

@MODEL_USAGE_CHART
AICONNECTION 18
IF RESULT < 0
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
$MODEL_USAGE_CHART_WAIT
