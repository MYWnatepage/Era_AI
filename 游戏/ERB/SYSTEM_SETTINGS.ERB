; 设置首页、通用开关与设置摘要排版。

@TITLE_SETTING

$TITLE_SETTING_SELECT

REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 设置
ALIGNMENT LEFT
DRAWLINE
CALL SETTING_WRAP, "本页面用于管理游戏显示、系统流程和 AI 对话等相关选项。", 0, 0
DRAWLINE

DISPLAYTYPE 8
LOCALS:22 '= STRFORM("%RESULTS:0% / %RESULTS:2%")
IF RESULT == 1
    LOCALS:22 '= LOCALS:22 + STRFORM(" / %RESULTS:1% 字/秒")
ENDIF
LOCALS:23 '= "当前：" + LOCALS:22
DISPLAYINFO
CALL SETTING_SUMMARY, "显示设置", STRFORM("文本：%RESULTS:0% / 背景：%RESULTS:1% / 焦点：%RESULTS:2% / 字体：%RESULTS:3% / 字号：%RESULTS:4% / 行距：%RESULTS:5% / 窗口：%RESULTS:6%×%RESULTS:7% / 剧情：%LOCALS:22%")
CALL SETTING_ROW, "[1] 文本颜色", STRFORM("当前：%RESULTS:0%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[2] 背景颜色", STRFORM("当前：%RESULTS:1%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[3] 焦点颜色", STRFORM("当前：%RESULTS:2%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[4] 字体样式", STRFORM("当前：%RESULTS:3%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[5] 字体大小", STRFORM("当前：%RESULTS:4%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[6] 行距设置", STRFORM("当前：%RESULTS:5%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[7] 窗口大小", STRFORM("当前：%RESULTS:6%×%RESULTS:7% / %RESULTS:8%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[8] 剧情显示", LOCALS:23, HTML_STRINGLEN("[17] 上下文管理　", 1)

DRAWLINE
MUSIC 0
CALL SETTING_SUMMARY, "声音设置", STRFORM("背景音乐：%RESULTS:0% / 音量：%RESULTS:1%％")
CALL SETTING_ROW, "[9] 背景音乐", STRFORM("当前：%RESULTS:0%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
CALL SETTING_ROW, "[10] 音乐音量", STRFORM("当前：%RESULTS:1%％"), HTML_STRINGLEN("[17] 上下文管理　", 1)

DRAWLINE
LOCALS:20 '= "关"
LOCALS:21 '= "关"
IF GLOBAL:300 == 1
    LOCALS:20 '= "开"
ENDIF
IF GLOBAL:301 == 1
    LOCALS:21 '= "开"
ENDIF
CALL SETTING_SUMMARY, "游戏设置", STRFORM("自动存档：%LOCALS:20% / 返回确认：%LOCALS:21%")

CALL SETTING_ROW, "[11] 自动存档", "当前：" + LOCALS:20, HTML_STRINGLEN("[17] 上下文管理　", 1)

CALL SETTING_ROW, "[12] 返回确认", "当前：" + LOCALS:21, HTML_STRINGLEN("[17] 上下文管理　", 1)

DRAWLINE
AIINFO
CALL SETTING_SUMMARY, "AI 模型设置", STRFORM("来源：%RESULTS:1% / 模型：%RESULTS:0%")
PRINTL [13] 模型连接设置
DRAWLINE
AIGENERATION 0
IF RESULT < 0
    PRINTL AI 生成设置
    PRINTFORML %RESULTS:0%
ELSE
    LOCALS:10 '= RESULTS:1
    IF STRFIND(RESULTS:1, "自动") == 0
        LOCALS:10 '= "自动"
    ENDIF
    LOCALS:11 '= "手动"
    IF STRFIND(RESULTS:12, "自动") == 0
        LOCALS:11 '= "自动"
    ENDIF
    CALL SETTING_SUMMARY, "AI 生成设置", STRFORM("采样：%RESULTS:0% / 回复：%RESULTS:11% / 预算：%LOCALS:10% / 上下文：%LOCALS:11% / 历史：%RESULTS:3% 轮 / 思考：%RESULTS:8%")
    CALL SETTING_ROW, "[14] 采样设置", STRFORM("当前：%RESULTS:0% / %RESULTS:14%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
    CALL SETTING_ROW, "[15] 回复长度", STRFORM("当前：%RESULTS:11% / 预算：%RESULTS:1%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
    CALL SETTING_ROW, "[16] 上下文管理", STRFORM("当前：%RESULTS:12% / 历史 %RESULTS:3% 轮"), HTML_STRINGLEN("[17] 上下文管理　", 1)
    CALL SETTING_ROW, "[17] 思考模式", STRFORM("当前：%RESULTS:8%"), HTML_STRINGLEN("[17] 上下文管理　", 1)
ENDIF

DRAWLINE
PRINTL [0] 返回标题

REDRAW 1
$TITLE_SETTING_INPUT
ESCAPE 0
MUSIC 7
INPUT
MUSIC 8

SELECTCASE RESULT
    CASE 0
        RETURN

    CASE 1
        CALL TITLE_SETTING_TEXT_COLOR
        GOTO TITLE_SETTING_SELECT

    CASE 2
        CALL TITLE_SETTING_BG_COLOR
        GOTO TITLE_SETTING_SELECT

    CASE 3
        CALL EDIT_DISPLAY_COLOR, 2
        GOTO TITLE_SETTING_SELECT

    CASE 4
        CALL TITLE_SETTING_FONT_NAME
        GOTO TITLE_SETTING_SELECT

    CASE 5
        CALL TITLE_SETTING_FONT_SIZE
        GOTO TITLE_SETTING_SELECT

    CASE 6
        CALL TITLE_SETTING_LINE_HEIGHT
        GOTO TITLE_SETTING_SELECT

    CASE 7
        CALL TITLE_SETTING_WINDOW_SIZE
        GOTO TITLE_SETTING_SELECT

    CASE 8
        DISPLAYTYPE 9
        $NARRATIVE_DISPLAY_WAIT
        TWAIT 30, 1
        DISPLAYTYPE 10
        IF RESULT == 0
            GOTO NARRATIVE_DISPLAY_WAIT
        ENDIF
        GOTO TITLE_SETTING_SELECT

    CASE 9
        CALL TITLE_SETTING_MUSIC
        GOTO TITLE_SETTING_SELECT

    CASE 10
        MUSIC 5
        $MUSIC_VOLUME_WAIT
        TWAIT 50, 1
        MUSIC 6
        IF RESULT == 0
            GOTO MUSIC_VOLUME_WAIT
        ENDIF
        GOTO TITLE_SETTING_SELECT

    CASE 9003
        GOTO TITLE_SETTING_SELECT

    CASE 9001, 9002
        IF RESULT == 9001
            RESULT = 1
        ELSE
            RESULT = -1
        ENDIF
        MUSIC 9
        IF RESULT < 0
            PRINTFORML %RESULTS:0%
            WAIT
        ENDIF
        GOTO TITLE_SETTING_SELECT

    CASE 11
        IF GLOBAL:300 == 1
            GLOBAL:300 = 0
        ELSE
            GLOBAL:300 = 1
        ENDIF
        SAVEGLOBAL
        GOTO TITLE_SETTING_SELECT

    CASE 12
        IF GLOBAL:301 == 1
            GLOBAL:301 = 0
        ELSE
            GLOBAL:301 = 1
        ENDIF
        SAVEGLOBAL
        GOTO TITLE_SETTING_SELECT

    CASE 13
        CALL TITLE_SETTING_AI_MODEL_INFO
        GOTO TITLE_SETTING_SELECT

    CASE 14
        CALL GENERATION_SAMPLING_PAGE
        GOTO TITLE_SETTING_SELECT
    CASE 15
        CALL GENERATION_LENGTH_PAGE
        GOTO TITLE_SETTING_SELECT
    CASE 16
        CALL GENERATION_CONTEXT_PAGE
        GOTO TITLE_SETTING_SELECT
    CASE 17
        CALL GENERATION_THINKING_PAGE
        GOTO TITLE_SETTING_SELECT


    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO TITLE_SETTING_INPUT
ENDSELECT

@PRINT_AUTOSAVE_NAME

IF GLOBAL:300 == 1
    PRINTFORM 开
ELSE
    PRINTFORM 关
ENDIF

RETURN

@PRINT_RETURN_CONFIRM_NAME

IF GLOBAL:301 == 1
    PRINTFORM 开
ELSE
    PRINTFORM 关
ENDIF

RETURN

@SETTING_SUMMARY, ARGS:0, ARGS:1
CALL SETTING_ROW, ARGS:0, "[" + ARGS:1 + "]", HTML_STRINGLEN("AI 生成设置　", 1)
RETURN
