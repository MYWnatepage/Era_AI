$SCENARIO_TEST_RAIN_ROOM_INPUT
ESCAPE 9
INPUT

SELECTCASE RESULT
    CASE 1
        CALL SCENARIO_TEST_RAIN_ROOM_TALK
        GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

    CASE 2
