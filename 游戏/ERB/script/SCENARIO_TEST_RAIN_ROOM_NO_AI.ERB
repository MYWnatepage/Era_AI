    CASE 4
        SAVEGAME
        GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

    CASE 5
        CALL LOAD_RAIN_ROOM_SAVES
        GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

    CASE 6
        CALL SCENARIO_TEST_RAIN_ROOM_MEMORY_VIEW
        GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

    CASE 7
        CALL SCENARIO_TEST_RAIN_ROOM_MEMORY_CLEAR
        GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

    CASE 9
        CALL GAME_RETURN_TITLE_CONFIRM
        IF GLOBAL:599 == 1
            BEGIN TITLE
        ENDIF
        GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO SCENARIO_TEST_RAIN_ROOM_INPUT
ENDSELECT

@SCENARIO_TEST_RAIN_ROOM_TALK

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 和艾拉对话
ALIGNMENT LEFT
DRAWLINE
PRINTL 请输入你想对艾拉说的话。
PRINTL
PRINTL 输入后，艾拉会根据你的话作出回应。
DRAWLINE

INPUTS
CALL APPLY_DISPLAY_SETTINGS

IF RESULTS:0 == ""
    RETURN
ENDIF

SAVESTR:20 '= "WAITING"
SAVESTR:21 '= RESULTS:0
SAVESTR:22 '= STRFORM("第{DAY}天 时间段{TIME}")

LOCALS:0 '= ""

LOCALS:1 '= STRFORM("你现在扮演角色：艾拉。角色设定：艾拉是一个温柔、安静、略带关心的少女，说话自然克制，不要夸张，不要解释自己是AI。当前场景：雨夜，玩家刚刚回到房间，房间里灯光很暗，窗外有细密雨声，艾拉一直在房间里等玩家。当前状态：艾拉对玩家的好感度为{FLAG:0}，玩家当前疲劳为{FLAG:1}。%LOCALS:0% 玩家现在对艾拉说：%SAVESTR:21% 请以艾拉的口吻回复，只输出艾拉对玩家说的话，不要输出旁白标题，不要输出系统信息，内容适合文字游戏窗口显示。")

AISTART LOCALS:1, SAVESTR:21, "rain_room", SAVESTR:22, 1024, 0, ""
IF RESULT != 0
    SAVESTR:20 '= ""
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
CALL SCENARIO_TEST_RAIN_ROOM_WAIT_RESPONSE

RETURN

@SCENARIO_TEST_RAIN_ROOM_WAIT_RESPONSE
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 片刻沉默
PRINTFORML 你对艾拉说：%SAVESTR:21%
PRINTL 艾拉沉默了片刻，像是在整理自己的措辞……
PRINTL 正在等待回应，按 Esc 可中止本次请求。
DRAWLINE
$NATIVE_STORY_WAIT
TWAIT 100, 1
AIPOLL
IF RESULT == 0
    GOTO NATIVE_STORY_WAIT
ELSEIF RESULT < 0
    IF RESULTS:0 == "本次请求已取消。"
        SAVESTR:20 '= ""
        RETURN
    ENDIF
    SAVESTR:20 '= ""
    PRINTFORML %RESULTS:0%
    PRINTL 按回车键返回，再次输入即可重试。
    WAIT
    RETURN
ENDIF
SAVESTR:19 '= RESULTS:0
SAVESTR:18 '= RESULTS:1
CALL SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE
RETURN

@SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE

$SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE_SELECT

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 艾拉的回应
ALIGNMENT LEFT
DRAWLINE

RESULTS:0 '= SAVESTR:19

IF RESULTS:0 == ""
    PRINTL 艾拉暂时没有回应。

ELSEIF RESULTS:0 == "（艾拉还没有回应。）"
    PRINTL 艾拉还没有回应。

ELSE
    IF SAVESTR:20 == "WAITING"
        CALL SCENARIO_TEST_RAIN_ROOM_ADD_HISTORY
        CALL SCENARIO_TEST_RAIN_ROOM_AFTER_TALK
    ENDIF

    PRINTFORML %SAVESTR:19%
    IF SAVESTR:18 != ""
        PRINTFORML %SAVESTR:18%
    ENDIF
ENDIF

