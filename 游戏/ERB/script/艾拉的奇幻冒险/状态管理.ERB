; 食材来自 SAVESTR:61 当前物品表；FLAG:20 仅作兼容显示缓存。
; FLAG:21 旧食材迁移标记，FLAG:22 最近结算日期，均随存档保存。
@RAIN_ROOM_ENSURE_FOOD
CALL RAIN_ROOM_ENSURE_INVENTORY
CALL RAIN_ROOM_SYNC_TIME
RETURN

@RAIN_ROOM_SETTLE_FOOD
CALL RAIN_ROOM_ENSURE_FOOD
IF FLAG:22 < DAY
    CALL RAIN_ROOM_SCENARIO_CARD
    LOCALS:0 '= RESULTS:19
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= LOCALS:0
    RESULTS:2 '= "2"
    RESULTS:3 '= "player,ella"
    AICONNECTION 36
    IF RESULT < 0
        CALL RAIN_ROOM_INVENTORY_ERROR
    ENDIF
    SAVESTR:61 '= RESULTS:0
    FLAG:20 = TOINT(RESULTS:1)
    FLAG:22 = DAY
ENDIF
RETURN FLAG:20 > 0

@RAIN_ROOM_SYNC_TIME
RESULTS:0 '= "ticks_per_day"
AICONNECTION 45
FLAG:25 = TOINT(RESULTS:0)
RESULTS:0 '= "hunt_ticks"
AICONNECTION 45
FLAG:26 = TOINT(RESULTS:0)
IF FLAG:24 == 0
    ; 旧版4时段转换为8格，不额外推进日期或扣食材。
    TIME = MIN(FLAG:25 - 1, MAX(0, TIME * 2))
    FLAG:24 = 1
ENDIF
RETURN

@RAIN_ROOM_CLOCK_LABEL
SELECTCASE TIME / 2
    CASE 0
        RESULTS:0 '= "清晨"
    CASE 1
        RESULTS:0 '= "上午"
    CASE 2
        RESULTS:0 '= "午后"
    CASEELSE
        RESULTS:0 '= "夜晚"
ENDSELECT
RETURN

@RAIN_ROOM_CLOCK_BAR
LOCALS:0 '= ""
FOR LOCAL, 0, 8
    IF LOCAL < MAX(0, MIN(8, TIME))
        LOCALS:0 '= LOCALS:0 + "■"
    ELSE
        LOCALS:0 '= LOCALS:0 + "□"
    ENDIF
NEXT
RESULTS:0 '= LOCALS:0
RETURN

@RAIN_ROOM_ADVANCE_TIME, ARG
; Copy the argument before helper calls reuse ARG; avoid nested REPEAT sharing COUNT.
LOCAL:0 = MAX(1, ARG)
IF FLAG:34 == 4
    LOCAL:0 = MAX(0, ARG)
ENDIF
CALL RAIN_ROOM_ENSURE_FOOD
IF FLAG:20 <= 0
    RETURN 0
ENDIF
FOR LOCAL:1, 0, LOCAL:0
    TIME += 1
    IF TIME >= FLAG:25
        TIME = 0
        CALL RAIN_ROOM_SETTLE_FOOD
        IF RESULT == 0
            RETURN 0
        ENDIF
        DAY += 1
    ENDIF
NEXT
RETURN 1

@RAIN_ROOM_FOOD_GAME_OVER
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTL 游戏结束
ALIGNMENT LEFT
DRAWLINE
PRINTFORML 第 {DAY} 天，食材已耗尽。
PRINTL 食材余量为 0，无法继续本次冒险。
IF SAVESTR:19 != ""
    DRAWLINE
    PRINTL 本次行动：
    PRINTFORML %SAVESTR:19%
    IF SAVESTR:62 != ""
        PRINTFORML %SAVESTR:62%
    ENDIF
ENDIF
DRAWLINE
PRINTL 按回车返回标题；可以读取较早的存档或开始新游戏。
WAIT
BEGIN TITLE
