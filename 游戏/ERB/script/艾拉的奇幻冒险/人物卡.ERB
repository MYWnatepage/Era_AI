; 初始人物列表。ARG=0 返回人数；ARG=1/2 返回对应卡片。
@RAIN_ROOM_INITIAL_CHARACTER, ARG
IF ARG == 0
    RETURN 2
ENDIF
SELECTCASE ARG
    CASE 1
        CALL RAIN_ROOM_CHARACTER_CARD
        RETURN 1
    CASE 2
        CALL RAIN_ROOM_PROTAGONIST_CARD
        RETURN 1
    CASEELSE
        FOR LOCAL, 0, 19
            RESULTS:LOCAL '= ""
        NEXT
        RETURN 0
ENDSELECT
RETURN 0
