    ENDIF

    IF LOCAL:19 == 0
        NARRATIVE SAVESTR:19
        $RAIN_ROOM_NARRATIVE_WAIT
        NARRATIVEPOLL
        IF RESULT == 0
            TWAIT 16, 1
            GOTO RAIN_ROOM_NARRATIVE_WAIT
