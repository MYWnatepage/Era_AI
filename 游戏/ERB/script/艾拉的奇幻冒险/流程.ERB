    CASE 4
        CALL RAIN_ROOM_STATUS_PAGE, 0
        GOTO SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE_SELECT
    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE_INPUT
ENDSELECT

@SCENARIO_TEST_RAIN_ROOM_AFTER_TALK
IF FLAG:34 == 1
    ; The received snapshot already includes the program-controlled hunt reward.
    FLAG:32 = DAY
    SAVESTR:68 '= STRFORM("狩猎：D20 {FLAG:30}，收获 {FLAG:31} 份食材")
ELSEIF FLAG:34 == 2
    SAVESTR:68 '= STRFORM("第{DAY}天结束，入眠")
ELSEIF FLAG:34 == 3
    SAVESTR:68 '= "在原地短暂休息"
ELSEIF FLAG:34 == 4
    RESULTS:0 '= SAVESTR:61
    AICONNECTION 55
    IF RESULT >= 0
        SAVESTR:68 '= "移动至" + RESULTS:0
    ELSE
        SAVESTR:68 '= "沿路前往选定地点"
    ENDIF
ELSE
    SAVESTR:68 '= "交谈或处理日常事务"
ENDIF
CALL RAIN_ROOM_ADVANCE_TIME, FLAG:35
FLAG:34 = 0
CALL GAME_AUTOSAVE
IF FLAG:20 <= 0
    CALL RAIN_ROOM_FOOD_GAME_OVER
ENDIF
RETURN

