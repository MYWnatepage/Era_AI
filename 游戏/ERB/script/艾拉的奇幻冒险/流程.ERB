        LOCAL:19 = 1
    ELSE
        PRINTFORML %SAVESTR:19%
    ENDIF
    IF SAVESTR:62 != ""
        DRAWLINE
        PRINTL 本轮变更：
        PRINTFORML %SAVESTR:62%
    ENDIF
    IF SAVESTR:18 != ""
        PRINTFORML %SAVESTR:18%
    ENDIF
