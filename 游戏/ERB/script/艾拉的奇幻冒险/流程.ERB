$SCENARIO_TEST_RAIN_ROOM_INPUT
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        CALL GAME_RETURN_TITLE_CONFIRM
        IF GLOBAL:599 == 1
            BEGIN TITLE
        ENDIF
    CASE 1
        CALL SCENARIO_TEST_RAIN_ROOM_TALK
    CASE 2
        CALL RAIN_ROOM_SLEEP
    CASE 3
        CALL RAIN_ROOM_SHORT_REST
    CASE 4
        CALL RAIN_ROOM_MOVE_PAGE
    CASE 5
        CALL RAIN_ROOM_LOCAL_ACTION
    CASE 6
        SAVEGAME
    CASE 7
        CALL LOAD_RAIN_ROOM_SAVES
    CASE 8
        CALL SCENARIO_TEST_RAIN_ROOM_HISTORY
    CASE 9
        CALL RAIN_ROOM_INVENTORY_PAGE, 1
    CASE 10
        CALL RAIN_ROOM_STATUS_PAGE, 0
    CASE 11
        CALL NATIVE_MEMORY_PAGE
    CASE 12
        CALL RAIN_ROOM_WORLD_PAGE
    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO SCENARIO_TEST_RAIN_ROOM_INPUT
ENDSELECT
GOTO SCENARIO_TEST_RAIN_ROOM_MAIN

@SCENARIO_TEST_RAIN_ROOM_TALK
CALL RAIN_ROOM_COMPOSE, "", 0
RETURN

@RAIN_ROOM_RUN_INPUT, ARGS:0, ARGS:1
RESULTS:0 '= ARGS:0
AICONNECTION 44
IF RESULT == 1
    CALL RAIN_ROOM_HUNT, ARGS:1, ARGS:0
    RETURN
ELSEIF RESULT == 2
    CALL RAIN_ROOM_SLEEP
    RETURN
ELSEIF RESULT == 3
    CALL RAIN_ROOM_SHORT_REST
    RETURN
ELSEIF RESULT == 4
    CALL RAIN_ROOM_MOVE_PAGE
    RETURN
ELSEIF RESULT == 5
    CALL RAIN_ROOM_TRADE
    RETURN
ENDIF
CALL RAIN_ROOM_ACTION_ALLOWED, 0
IF RESULT == 0
    RETURN
ENDIF
FLAG:34 = 0
FLAG:35 = 1
CALL RAIN_ROOM_REQUEST_ACTION, ARGS:0, 0, 0, 0, 0, "", ARGS:1
RETURN

@RAIN_ROOM_REQUEST_ACTION, ARGS:0, ARG:0, ARG:1, ARG:2, ARG:3, ARGS:1, ARGS:2
SAVESTR:18 '= ""
SAVESTR:20 '= "WAITING"
SAVESTR:21 '= ARGS:0
SAVESTR:22 '= STRFORM("第{DAY}天 时间{TIME}/{FLAG:25}")
CALL RAIN_ROOM_BUILD_PROMPT, SAVESTR:21
LOCALS:1 '= RESULTS:0
IF ARG:0 > 0
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= STRFORM("{ARG:0}")
    IF ARG:1 == 1
        RESULTS:2 '= "bandage"
    ELSE
        RESULTS:2 '= "context"
    ENDIF
    RESULTS:3 '= STRFORM("{ARG:2}")
    RESULTS:4 '= STRFORM("{ARG:3}")
    IF ARG:1 == 0 && ARGS:1 != "" && ARGS:1 != "player"
        RESULTS:2 '= ARGS:1
        AICONNECTION 63
    ELSE
        AICONNECTION 62
    ENDIF
    IF RESULT < 0
        SAVESTR:18 '= RESULTS:0
        SAVESTR:20 '= ""
        PRINTFORML %SAVESTR:18%
        WAIT
        RETURN
    ENDIF
ENDIF
IF FLAG:34 == 1
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= STRFORM("{FLAG:30}")
    RESULTS:2 '= "hunt"
    AICONNECTION 41
    IF RESULT < 0
        CALL RAIN_ROOM_INVENTORY_ERROR
    ENDIF
ENDIF
IF ARGS:2 != ""
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= ARGS:2
    AICONNECTION 64
    IF RESULT < 0
        SAVESTR:20 '= ""
        PRINTFORML %RESULTS:0%
        WAIT
        RETURN
    ENDIF
ENDIF
AISTART LOCALS:1, SAVESTR:21, "rain_room", SAVESTR:22, 1024, 0, ""
IF RESULT != 0
    IF FLAG:34 == 1
        CALL RAIN_ROOM_HUNT_FALLBACK
        RETURN
    ENDIF
    SAVESTR:18 '= RESULTS:0
    SAVESTR:20 '= ""
    PRINTFORML %SAVESTR:18%
    WAIT
    RETURN
ENDIF
CALL SCENARIO_TEST_RAIN_ROOM_WAIT_RESPONSE
RETURN

@SCENARIO_TEST_RAIN_ROOM_WAIT_RESPONSE
CALL RAIN_ROOM_CHARACTER_CARD
LOCALS:15 '= RESULTS:0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 稍候片刻……
PRINTFORML 你的行动：%SAVESTR:21%
IF FLAG:34 == 1
    PRINTL 按 Esc 可略过详细经过，保留这次狩猎的收获与用时。
ELSE
    PRINTL 按 Esc 可取消此次行动。
ENDIF
DRAWLINE
$NATIVE_STORY_WAIT
TWAIT 100, 1
AIPOLL
IF RESULT == 0
    GOTO NATIVE_STORY_WAIT
ELSEIF RESULT < 0
    IF FLAG:34 == 1
        CALL RAIN_ROOM_HUNT_FALLBACK
        RETURN
    ENDIF
    IF RESULTS:0 == "本次请求已取消。"
        SAVESTR:18 '= "本次请求已取消，未采用本轮剧情，物品、人物状态和时间未变。"
        SAVESTR:20 '= ""
        RETURN
    ENDIF
    SAVESTR:18 '= RESULTS:0
    SAVESTR:20 '= ""
    PRINTFORML %SAVESTR:18%
    PRINTL 按回车键返回，再次输入即可重试。
    WAIT
    RETURN
ENDIF
; Only a fully validated batch reaches this point. Commit once before displaying/advancing time.
LOCALS:10 '= RESULTS:0
LOCALS:11 '= RESULTS:1
LOCALS:12 '= RESULTS:2
LOCALS:13 '= RESULTS:3
LOCALS:14 '= RESULTS:4
LOCAL:10 = TOINT(RESULTS:5)
LOCALS:16 '= RESULTS:6
IF LOCAL:10 == 1
    CALL RAIN_ROOM_REVIEW_ITEMS, LOCALS:10, LOCALS:13, LOCALS:16, LOCALS:11
    IF RESULT != 1
        SAVESTR:18 '= "本轮提案已取消，物品、人物状态和时间未变。"
        SAVESTR:20 '= ""
        SAVESTR:21 '= ""
        SAVESTR:22 '= ""
        RETURN
    ENDIF
ENDIF
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= LOCALS:12
AICONNECTION 35
IF RESULT < 0
    SAVESTR:18 '= RESULTS:0
    SAVESTR:20 '= ""
    PRINTFORML %SAVESTR:18%
    WAIT
    RETURN
ENDIF
SAVESTR:61 '= RESULTS:0
CALL RAIN_ROOM_INVENTORY_FOOD_STATUS
SAVESTR:62 '= LOCALS:13
SAVESTR:66 '= LOCALS:14
SAVESTR:19 '= LOCALS:10
SAVESTR:18 '= LOCALS:11
CALL RAIN_ROOM_APPEND_LOCAL_MEMORY
CALL SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE, LOCAL:10
RETURN
