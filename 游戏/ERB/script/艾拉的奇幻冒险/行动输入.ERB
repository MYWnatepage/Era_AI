; This page is a one-request context picker. Nothing is written to inventory until a turn is adopted.
@RAIN_ROOM_COMPOSE, ARGS:0, ARG:0
#DIMS PICKED
#DIMS COMMAND
#DIMS PRESET, 3
#DIM PICK_PAGE
#DIM PICK_PAGES
#DIM PRESET_COUNT
#DIM HUNT_MODE
#DIM TRADE_MODE
#DIM FREE_MODE
PICKED '= ""
PICK_PAGE = 0
HUNT_MODE = ARG:0 == 1
TRADE_MODE = ARG:0 == 2
FREE_MODE = 0
RESULTS:0 '= SAVESTR:66
AICONNECTION 43
PRESET_COUNT = MIN(2, RESULT)
FOR LOCAL, 0, 3
    PRESET:LOCAL '= RESULTS:LOCAL
NEXT
IF TRADE_MODE == 1
    PRESET_COUNT = 2
    PRESET:0 '= "询问这里的货物与价格"
    PRESET:1 '= "向商贩展示选中的物品，询问收购价格"
    IF ARGS:0 != ""
        PRESET:0 '= ARGS:0
    ENDIF
ENDIF
$RAIN_ROOM_COMPOSE_REDRAW
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
IF HUNT_MODE == 1
    PRINTL 狩猎
ELSEIF TRADE_MODE == 1
    PRINTL 交易
ELSEIF FREE_MODE == 1
    PRINTL 自由输入
ELSE
    PRINTL 对话与行动
ENDIF
DRAWLINE
PRINTL 相关物品（可多选）
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{PICK_PAGE}")
RESULTS:2 '= PICKED
RESULTS:3 '= "select"
AICONNECTION 85
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
PICK_PAGES = TOINT(RESULTS:0)
PICK_PAGE = TOINT(RESULTS:4)
LOCALS:0 '= RESULTS:2
IF LOCALS:0 == ""
    PRINTL 已选：无
ELSE
    PRINTFORML 已选：%LOCALS:0%
ENDIF
IF PICK_PAGE > 0
    PRINTBUTTON "上一页", "@prev"
    PRINT 　
ENDIF
IF PICK_PAGE + 1 < PICK_PAGES
    PRINTBUTTON "下一页", "@next"
ENDIF
IF PICKED != ""
    PRINTBUTTON "清空选择", "@clear"
ENDIF
PRINTL
DRAWLINE
IF HUNT_MODE == 1
    PRINTBUTTON "开始狩猎（D20）", "@hunt"
    PRINTL
ELSEIF FREE_MODE == 0
    FOR LOCAL, 0, PRESET_COUNT
        PRINTBUTTON STRFORM("[{LOCAL + 1}] ") + PRESET:LOCAL, STRFORM("@preset:{LOCAL}")
        PRINTL
    NEXT
    PRINTBUTTON "[3] 自由输入", "@free"
    PRINTL
ENDIF
IF FREE_MODE == 0
    DRAWLINE
ENDIF
PRINTBUTTON "[0] 返回行动菜单", "0"
PRINTL
INPUTS
COMMAND '= RESULTS:0
IF HUNT_MODE == 0 && FREE_MODE == 0 && COMMAND == "3"
    COMMAND '= "@free"
ENDIF
IF HUNT_MODE == 0 && FREE_MODE == 0
    FOR LOCAL, 0, PRESET_COUNT
        IF COMMAND == STRFORM("{LOCAL + 1}")
            COMMAND '= STRFORM("@preset:{LOCAL}")
            BREAK
        ENDIF
    NEXT
ENDIF
IF COMMAND == "" || COMMAND == "0"
    RETURN
ELSEIF COMMAND == "@free" && HUNT_MODE == 0
    FREE_MODE = 1
    GOTO RAIN_ROOM_COMPOSE_REDRAW
ELSEIF COMMAND == "@clear"
    PICKED '= ""
    GOTO RAIN_ROOM_COMPOSE_REDRAW
ELSEIF COMMAND == "@prev"
    PICK_PAGE = MAX(0, PICK_PAGE - 1)
    GOTO RAIN_ROOM_COMPOSE_REDRAW
ELSEIF COMMAND == "@next"
    PICK_PAGE = MIN(PICK_PAGES - 1, PICK_PAGE + 1)
    GOTO RAIN_ROOM_COMPOSE_REDRAW
ELSEIF STRFIND(COMMAND, "@adjust:") == 0
    LOCAL:2 = STRFIND(COMMAND, ":", 8)
    IF LOCAL:2 < 0
        GOTO RAIN_ROOM_COMPOSE_REDRAW
    ENDIF
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= PICKED
    RESULTS:2 '= SUBSTRING(COMMAND, 8, LOCAL:2 - 8)
    RESULTS:3 '= SUBSTRING(COMMAND, LOCAL:2 + 1)
    AICONNECTION 91
    IF RESULT >= 0
        PICKED '= RESULTS:0
    ENDIF
    GOTO RAIN_ROOM_COMPOSE_REDRAW
ELSEIF STRFIND(COMMAND, "@item:") == 0
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= PICKED
    RESULTS:2 '= SUBSTRING(COMMAND, 6)
    RESULTS:3 '= "1"
    AICONNECTION 91
    IF RESULT < 0
        PRINTFORML %RESULTS:0%
        WAIT
    ELSE
        PICKED '= RESULTS:0
    ENDIF
    GOTO RAIN_ROOM_COMPOSE_REDRAW
ELSEIF STRFIND(COMMAND, "@use:") == 0
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= PICKED
    RESULTS:2 '= SUBSTRING(COMMAND, 5)
    AICONNECTION 94
    IF RESULT < 0
        PRINTFORML %RESULTS:0%
        WAIT
        GOTO RAIN_ROOM_COMPOSE_REDRAW
    ENDIF
    LOCAL:0 = TOINT(RESULTS:0)
    CALL RAIN_ROOM_ITEM_ACTION, LOCAL:0, 1, PICKED
    RETURN
ELSEIF STRFIND(COMMAND, "@preset:") == 0
    LOCAL:0 = -1
    FOR LOCAL:1, 0, PRESET_COUNT
        IF COMMAND == STRFORM("@preset:{LOCAL:1}")
            LOCAL:0 = LOCAL:1
        ENDIF
    NEXT
    IF LOCAL:0 < 0 || LOCAL:0 >= PRESET_COUNT
        GOTO RAIN_ROOM_COMPOSE_REDRAW
    ENDIF
    COMMAND '= PRESET:(LOCAL:0)
ELSEIF COMMAND == "@hunt"
    COMMAND '= "我在这里狩猎。"
ENDIF
IF HUNT_MODE == 1
    CALL RAIN_ROOM_HUNT, PICKED, COMMAND
ELSE
    CALL RAIN_ROOM_RUN_INPUT, COMMAND, PICKED
ENDIF
RETURN
