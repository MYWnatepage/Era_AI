; 查看人物、所在地与持续状态；待确认提案页为只读，不推进时间。
@RAIN_ROOM_STATUS_PAGE, ARG
#DIM STATUS_PAGE
#DIM STATUS_PAGES
#DIM STATUS_READ_ONLY
STATUS_PAGE = 0
; Proposal review passes 1: inspecting people must not invalidate a paid candidate revision.
STATUS_READ_ONLY = ARG
$RAIN_ROOM_STATUS_REDRAW
CALL RAIN_ROOM_ENSURE_INVENTORY
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{STATUS_PAGE}")
AICONNECTION 89
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
    RETURN
ENDIF
FOR LOCAL, 0, 24
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
STATUS_PAGES = TOINT(LOCALS:10)
STATUS_PAGE = MIN(STATUS_PAGE, STATUS_PAGES - 1)
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTL 当前人物状态
ALIGNMENT LEFT
DRAWLINE
PRINTFORML 共 %LOCALS:11% 位人物 / 第 {STATUS_PAGE + 1} 页，共 {STATUS_PAGES} 页
IF LOCALS:11 == "0"
    PRINTL 暂无已登记的人物。
ELSE
    FOR LOCAL, 0, 10
        IF LOCALS:LOCAL != ""
            PRINTFORML %LOCALS:LOCAL%
        ENDIF
    NEXT
ENDIF
DRAWLINE
IF STATUS_PAGE > 0
    PRINTL [1001] 上一页
ENDIF
IF STATUS_PAGE + 1 < STATUS_PAGES
    PRINTL [1002] 下一页
ENDIF
PRINTL [0] 返回上一页
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSEIF RESULT == 1001
    STATUS_PAGE = MAX(0, STATUS_PAGE - 1)
ELSEIF RESULT == 1002
    STATUS_PAGE = MIN(STATUS_PAGES - 1, STATUS_PAGE + 1)
ELSEIF RESULT >= 1 && RESULT <= 10
    IF LOCALS:(RESULT + 11) != ""
        CALL RAIN_ROOM_STATUS_CHARACTER, LOCALS:(RESULT + 11), STATUS_READ_ONLY
    ENDIF
ENDIF
GOTO RAIN_ROOM_STATUS_REDRAW

@RAIN_ROOM_STATUS_CHARACTER, ARGS:0, ARG
#DIM STATUS_PAGE
#DIM STATUS_PAGES
#DIM STATUS_READ_ONLY
STATUS_PAGE = 0
STATUS_READ_ONLY = ARG
$RAIN_ROOM_STATUS_CHARACTER_REDRAW
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= ARGS:0
RESULTS:2 '= STRFORM("{STATUS_PAGE}")
AICONNECTION 90
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
    RETURN
ENDIF
FOR LOCAL, 0, 32
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
STATUS_PAGES = TOINT(LOCALS:3)
STATUS_PAGE = MIN(STATUS_PAGE, STATUS_PAGES - 1)
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTFORML %LOCALS:0%
DRAWLINE
CALL SETTING_ROW, "人物分类：", LOCALS:29, 0
CALL SETTING_ROW, "当前地点：", LOCALS:1, 0
IF LOCALS:30 == "major" || LOCALS:24 != "未记录"
    CALL SETTING_ROW, "年龄：", LOCALS:24, 0
ENDIF
IF LOCALS:30 == "major" || LOCALS:25 != "未记录"
    CALL SETTING_ROW, "身高：", LOCALS:25, 0
ENDIF
IF LOCALS:30 == "major" || LOCALS:26 != "未记录"
    CALL SETTING_ROW, "体重：", LOCALS:26, 0
ENDIF
CALL SETTING_ROW, "身体状况：", LOCALS:27, 0
IF LOCALS:28 != ""
    PRINTFORML %LOCALS:28%
ENDIF
PRINTFORML 有效状态：%LOCALS:2% 条 / 第 {STATUS_PAGE + 1} 页，共 {STATUS_PAGES} 页
DRAWLINE
IF LOCALS:2 == "0"
    PRINTL 暂无额外伤势、病症等持续状态记录。
ELSE
    FOR LOCAL, 4, 14
        IF LOCALS:LOCAL != ""
            PRINTFORML %LOCALS:LOCAL%
        ENDIF
    NEXT
ENDIF
DRAWLINE
IF STATUS_PAGE > 0
    PRINTL [1001] 上一页
ENDIF
IF STATUS_PAGE + 1 < STATUS_PAGES
    PRINTL [1002] 下一页
ENDIF
IF LOCALS:31 == "1" && STATUS_READ_ONLY == 0
    IF LOCALS:30 == "minor"
        PRINTL [1003] 设为主要人物
    ELSE
        PRINTL [1003] 设为次要人物
    ENDIF
ENDIF
PRINTL [0] 返回人物列表
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSEIF RESULT == 1001
    STATUS_PAGE = MAX(0, STATUS_PAGE - 1)
ELSEIF RESULT == 1002
    STATUS_PAGE = MIN(STATUS_PAGES - 1, STATUS_PAGE + 1)
ELSEIF RESULT == 1003 && LOCALS:31 == "1" && STATUS_READ_ONLY == 0
    IF LOCALS:30 == "minor"
        CALL RAIN_ROOM_STATUS_SET_IMPORTANCE, ARGS:0, "major", LOCALS:0
    ELSE
        CALL RAIN_ROOM_STATUS_SET_IMPORTANCE, ARGS:0, "minor", LOCALS:0
    ENDIF
ELSEIF RESULT >= 1 && RESULT <= 10
    IF LOCALS:(RESULT + 13) != ""
        CALL RAIN_ROOM_STATUS_DETAIL, LOCALS:(RESULT + 13)
    ENDIF
ENDIF
GOTO RAIN_ROOM_STATUS_CHARACTER_REDRAW

@RAIN_ROOM_STATUS_DETAIL, ARGS:0
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= ARGS:0
AICONNECTION 53
IF RESULT < 0
    PRINTL 请选择已有状态的编号。
    WAIT
    RETURN
ENDIF
FOR LOCAL, 0, 8
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTFORML %LOCALS:0%
DRAWLINE
CALL SETTING_ROW, "所属人物：", LOCALS:1, 0
CALL SETTING_ROW, "状态类别：", LOCALS:2, 0
CALL SETTING_ROW, "当前程度：", LOCALS:3, 0
CALL SETTING_ROW, "状态描述：", LOCALS:4, 0
CALL SETTING_ROW, "当前影响：", LOCALS:5, 0
CALL SETTING_ROW, "发生时间：", LOCALS:6, 0
CALL SETTING_ROW, "更新时间：", LOCALS:7, 0
DRAWLINE
PRINTL [0] 返回人物详情
ESCAPE 0
INPUT
RETURN

@RAIN_ROOM_STATUS_SET_IMPORTANCE, ARGS:0, ARGS:1, ARGS:2
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
IF ARGS:1 == "major"
    PRINTFORML 将%ARGS:2%设为主要人物？
ELSE
    PRINTFORML 将%ARGS:2%设为次要人物？
ENDIF
PRINTL 完整人物资料和已有伤势、位置均会保留。
DRAWLINE
PRINTL [1] 确认
PRINTL [0] 取消
ESCAPE 0
INPUT
IF RESULT != 1
    RETURN
ENDIF
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= ARGS:0
RESULTS:2 '= ARGS:1
AICONNECTION 109
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
    RETURN
ENDIF
SAVESTR:61 '= RESULTS:0
PRINTL 人物分类已更新；请保存进度以保留修改。
WAIT
RETURN
