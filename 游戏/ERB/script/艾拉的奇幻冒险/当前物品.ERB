; SAVESTR:61：版本化当前物品与人物状态快照。初始卡仅在新游戏或旧存档迁移时复制。
; SAVESTR:62：最近一轮可显示的物品变更摘要，不包含软件指令。
@RAIN_ROOM_ENSURE_INVENTORY
RESULTS:0 '= "rain_room"
AICONNECTION 47
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
IF SAVESTR:61 == ""
    AICONNECTION 30
    LOCALS:0 '= RESULTS:0
    CALL RAIN_ROOM_INITIAL_ITEM, 0
    LOCAL:0 = RESULT
    FOR LOCAL:1, 1, LOCAL:0 + 1
        CALL RAIN_ROOM_INITIAL_ITEM, LOCAL:1
        FOR LOCAL:2, 0, 8
            LOCALS:(LOCAL:2 + 1) '= RESULTS:(LOCAL:2)
        NEXT
        RESULTS:0 '= LOCALS:0
        RESULTS:1 '= LOCALS:1
        RESULTS:2 '= LOCALS:2
        RESULTS:3 '= LOCALS:3
        RESULTS:4 '= LOCALS:4
        RESULTS:5 '= LOCALS:5
        RESULTS:6 '= LOCALS:6
        RESULTS:7 '= LOCALS:7
        RESULTS:8 '= LOCALS:8
        AICONNECTION 31
        IF RESULT < 0
            CALL RAIN_ROOM_INVENTORY_ERROR
        ENDIF
        LOCALS:0 '= RESULTS:0
    NEXT
    ; 已经接入每日消耗的旧档保留真实余量，不能重新补成10份。
    IF FLAG:21 == 1
        RESULTS:0 '= LOCALS:0
        RESULTS:1 '= STRFORM("{FLAG:20}")
        RESULTS:2 '= "2"
        RESULTS:3 '= "player"
        AICONNECTION 33
        IF RESULT < 0
            CALL RAIN_ROOM_INVENTORY_ERROR
        ENDIF
        LOCALS:0 '= RESULTS:0
    ELSE
        FLAG:22 = MAX(0, DAY - 1)
    ENDIF
    SAVESTR:61 '= LOCALS:0
ENDIF
RESULTS:0 '= SAVESTR:61
AICONNECTION 92
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
SAVESTR:61 '= RESULTS:0
CALL RAIN_ROOM_ENSURE_CHARACTER_PROFILES, 0
CALL RAIN_ROOM_INVENTORY_FOOD_STATUS
FLAG:21 = 1
RETURN

; 补齐旧档缺少的身体资料；只有显式新游戏传入1才登记初始健康。
@RAIN_ROOM_ENSURE_CHARACTER_PROFILES, ARG
#DIM PROFILE_NEW_GAME
#DIM PROFILE_COUNT
#DIMS PROFILE_DATA, 19
PROFILE_NEW_GAME = ARG
CALL RAIN_ROOM_INITIAL_CHARACTER, 0
PROFILE_COUNT = RESULT
FOR LOCAL:0, 1, PROFILE_COUNT + 1
    CALL RAIN_ROOM_INITIAL_CHARACTER, LOCAL:0
    FOR LOCAL:1, 0, 19
        PROFILE_DATA:(LOCAL:1) '= RESULTS:(LOCAL:1)
    NEXT
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= PROFILE_DATA:3
    RESULTS:2 '= PROFILE_DATA:14
    RESULTS:3 '= PROFILE_DATA:15
    RESULTS:4 '= PROFILE_DATA:16
    RESULTS:5 '= PROFILE_DATA:17
    RESULTS:6 '= PROFILE_DATA:18
    RESULTS:7 '= STRFORM("{PROFILE_NEW_GAME}")
    AICONNECTION 96
    IF RESULT < 0
        CALL RAIN_ROOM_INVENTORY_ERROR
    ENDIF
    SAVESTR:61 '= RESULTS:0
NEXT
RETURN

@RAIN_ROOM_INVENTORY_ERROR
PRINTFORML %RESULTS:0%
PRINTL 当前物品无法读取或结算，未重置存档。按回车返回标题。
WAIT
BEGIN TITLE

@RAIN_ROOM_INVENTORY_PAGE, ARG:0
#DIM INV_PAGE
#DIM INV_PAGES
INV_PAGE = 0
$RAIN_ROOM_INVENTORY_REDRAW
CALL RAIN_ROOM_ENSURE_INVENTORY
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTL 当前物品
ALIGNMENT LEFT
DRAWLINE
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{INV_PAGE}")
RESULTS:2 '= ""
RESULTS:3 '= "browse"
AICONNECTION 85
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
INV_PAGES = TOINT(RESULTS:0)
INV_PAGE = TOINT(RESULTS:4)
LOCALS:0 '= RESULTS:1
DRAWLINE
PRINTFORML 共 %LOCALS:0% 种物品 / 第 {INV_PAGE + 1} 页，共 {INV_PAGES} 页
IF INV_PAGE > 0
    PRINTL [9001] 上一页
ENDIF
IF INV_PAGE + 1 < INV_PAGES
    PRINTL [9002] 下一页
ENDIF
PRINTL 使用说明：点击物品名称查看详情；关联物品请在行动前选择。
PRINTL [0] 返回剧本页面
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSEIF RESULT == 9001
    INV_PAGE = MAX(0, INV_PAGE - 1)
    GOTO RAIN_ROOM_INVENTORY_REDRAW
ELSEIF RESULT == 9002
    INV_PAGE = MIN(INV_PAGES - 1, INV_PAGE + 1)
    GOTO RAIN_ROOM_INVENTORY_REDRAW
ENDIF
IF RESULT < 10001
    GOTO RAIN_ROOM_INVENTORY_REDRAW
ENDIF
RESULTS:1 '= STRFORM("{RESULT - 10000}")
RESULTS:0 '= SAVESTR:61
AICONNECTION 37
IF RESULT < 0
    PRINTL 请选择已有物品。
    WAIT
    GOTO RAIN_ROOM_INVENTORY_REDRAW
ENDIF
FOR LOCAL, 0, 6
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTFORML %LOCALS:0%（编号 %LOCALS:5%）
DRAWLINE
PRINTFORML 类型：%LOCALS:2%
PRINTFORML 数量与归属：%LOCALS:4%
PRINTFORML 描述：%LOCALS:1%
IF LOCALS:3 != ""
    PRINTFORML 属性：%LOCALS:3%
ENDIF
DRAWLINE
PRINTL [0] 返回物品列表
ESCAPE 0
INPUT
GOTO RAIN_ROOM_INVENTORY_REDRAW
