; This package owns all story-specific FLAG / SAVESTR meanings and legacy migrations.
@INIT_RAIN_ROOM_GAME
RESULTS:0 '= "rain_room"
AICONNECTION 47
SAVESTR:0 '= "rain_room"
FLAG:0 = 0
FLAG:1 = 0
FLAG:2 = 1
FLAG:9 = 0
FLAG:20 = 0
FLAG:21 = 0
FLAG:22 = 0
FLAG:24 = 1
FOR LOCAL, 30, 38
    FLAG:LOCAL = 0
NEXT
SAVESTR:61 '= ""
SAVESTR:62 '= ""
SAVESTR:66 '= "[]"
SAVESTR:68 '= "尚未开始行动"
GLOBAL:500 = 1
GLOBAL:501 = 0
GLOBAL:502 = 0
GLOBAL:503 = 1
GLOBAL:510 = 0
CALL NEW_RAIN_ROOM_AI_HISTORY
; Only an explicit new game receives the opening scene; inventory migration must keep it unknown.
CALL RAIN_ROOM_ENSURE_INVENTORY
CALL RAIN_ROOM_ENSURE_CHARACTER_PROFILES, 1
RESULTS:0 '= SAVESTR:61
AICONNECTION 57
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
SAVESTR:61 '= RESULTS:0
SAVEGLOBAL
RETURN 1

@RAIN_ROOM_AFTER_LOAD
GLOBAL:500 = 1
GLOBAL:501 = 0
GLOBAL:502 = 0
GLOBAL:503 = 1
GLOBAL:510 = 0
FOR LOCAL, 25, 53, 3
    IF SAVESTR:LOCAL != ""
        GLOBAL:510 += 1
    ENDIF
NEXT
CALL RESTORE_RAIN_ROOM_AI_HISTORY
IF RESULT < 0
    RETURN -1
ENDIF
CALL RAIN_ROOM_ENSURE_FOOD
SAVEGLOBAL
RETURN 1

@RAIN_ROOM_LEGACY_PROBE
RETURN FLAG:2 == 1

@RAIN_ROOM_TURN_END
CALL RAIN_ROOM_ADVANCE_TIME
CALL GAME_AUTOSAVE
IF FLAG:20 <= 0
    CALL RAIN_ROOM_FOOD_GAME_OVER
ENDIF
RETURN 1

@RAIN_ROOM_SAVE_CAPTION
AICONNECTION 51
RESULTS:0 '= STRFORM("%RESULTS:1% 第{DAY}天 食材{FLAG:20}份")
RETURN 1

; Legacy function names remain package-local adapters, never framework dependencies.
@LOAD_RAIN_ROOM_SAVES
CALL LOAD_SCENARIO_SAVES, "rain_room"
RETURN

@CHECK_RAIN_ROOM_SAVE, ARG
LOCAL = ARG
CALL CHECK_SCENARIO_SAVE, LOCAL, "rain_room"
RETURN RESULT

@RAIN_ROOM_INVENTORY_FOOD_STATUS
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= "2"
RESULTS:4 '= "player,ella"
AICONNECTION 32
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
SAVESTR:61 '= RESULTS:0
FLAG:20 = TOINT(RESULTS:1)
RETURN
