; An explicit player selection accompanies the original input. Merely selecting never consumes.
@RAIN_ROOM_ITEM_ACTION, ARG:0, ARG:1, ARGS:0
#DIM ITEM_ID
#DIM ITEM_MODE
#DIM TARGET_ID
#DIM ITEM_ROLL
#DIM TARGET_PAGE
#DIM TARGET_PAGES
#DIMS ITEM_OWNER
#DIMS OWNER_LABEL
#DIMS ITEM_LABEL
#DIMS INPUT_TEXT
ITEM_ID = ARG:0
ITEM_MODE = 0
TARGET_ID = 0
ITEM_ROLL = 0
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{ITEM_ID}")
AICONNECTION 60
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
ITEM_OWNER '= RESULTS:5
OWNER_LABEL '= RESULTS:6
ITEM_LABEL '= RESULTS:0
LOCAL:9 = TOINT(RESULTS:4)
IF ITEM_OWNER == ""
    PRINTL 该物品当前没有在场人物持有，仍可在详情页查看，未准备行动。
    WAIT
    RETURN
ENDIF
IF ARG:1 == 1 && LOCAL:9 == 1
    ITEM_MODE = 1
    GOTO RAIN_ROOM_ITEM_USAGE
ENDIF
RETURN
$RAIN_ROOM_ITEM_USAGE
IF ITEM_MODE == 1
    TARGET_PAGE = 0
    $RAIN_ROOM_ITEM_TARGET
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= STRFORM("{ITEM_ID}")
    RESULTS:2 '= STRFORM("{TARGET_PAGE}")
    AICONNECTION 61
    IF TOINT(RESULTS:11) == 0
        PRINTL 当前没有可用此材料处理的在场伤势，未消耗物品。
        WAIT
        RETURN
    ENDIF
    TARGET_PAGES = TOINT(RESULTS:10)
    FOR LOCAL, 0, 10
        LOCALS:LOCAL '= RESULTS:LOCAL
    NEXT
    CLEARLINE LINECOUNT
    CALL APPLY_DISPLAY_SETTINGS
    DRAWLINE
    PRINTL 选择需要包扎的伤势编号
    DRAWLINE
    FOR LOCAL, 0, 10
        IF LOCALS:LOCAL != ""
            PRINTFORML %LOCALS:LOCAL%
        ENDIF
    NEXT
    IF TARGET_PAGE > 0
        PRINTL [1001] 上一页
    ENDIF
    IF TARGET_PAGE + 1 < TARGET_PAGES
        PRINTL [1002] 下一页
    ENDIF
    PRINTL 使用说明：只能处理在场人物的未包扎伤势；不会直接使其痊愈。
    PRINTL [0] 取消
    ESCAPE 0
    INPUT
    IF RESULT == 0
        RETURN
    ELSEIF RESULT == 1001
        TARGET_PAGE = MAX(0, TARGET_PAGE - 1)
        GOTO RAIN_ROOM_ITEM_TARGET
    ELSEIF RESULT == 1002
        TARGET_PAGE = MIN(TARGET_PAGES - 1, TARGET_PAGE + 1)
        GOTO RAIN_ROOM_ITEM_TARGET
    ENDIF
    TARGET_ID = RESULT
    DRAWLINE
    PRINTL [1] 直接包扎
    PRINTL [2] D20 判定处理效果
    PRINTL [0] 取消
    ESCAPE 0
    INPUT
    IF RESULT == 0
        RETURN
    ELSEIF RESULT == 2
        ITEM_ROLL = RAND:20 + 1
    ELSEIF RESULT != 1
        RETURN
    ENDIF
    INPUT_TEXT '= STRFORM("使用选中的%ITEM_LABEL%包扎所选伤势。")
    PRINTL [1] 按所选用法执行
    PRINTL [2] 补充行动描述
    PRINTL [0] 取消
    ESCAPE 0
    INPUT
    IF RESULT == 0
        RETURN
    ELSEIF RESULT == 2
        PRINTL 输入本次包扎的补充描述；留空或 Esc 取消。材料消耗及处理结果由所选用法决定。
        INPUTS
        IF RESULTS:0 == ""
            RETURN
        ENDIF
        INPUT_TEXT '= RESULTS:0
    ELSEIF RESULT != 1
        RETURN
    ENDIF
ELSE
    DRAWLINE
    PRINTL 输入与选中物品有关的对话或行动；留空或 Esc 取消。
    INPUTS
    IF RESULTS:0 == ""
        RETURN
    ENDIF
    INPUT_TEXT '= RESULTS:0
ENDIF
FLAG:34 = 0
FLAG:35 = 1
CALL RAIN_ROOM_REQUEST_ACTION, INPUT_TEXT, ITEM_ID, ITEM_MODE, TARGET_ID, ITEM_ROLL, ITEM_OWNER, ARGS:0
RETURN

@RAIN_ROOM_WORLD_PAGE
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 场景与人物所在地
DRAWLINE
PRINTL [0] 返回行动菜单
RESULTS:0 '= SAVESTR:61
AICONNECTION 97
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
ESCAPE 0
INPUT
RETURN
