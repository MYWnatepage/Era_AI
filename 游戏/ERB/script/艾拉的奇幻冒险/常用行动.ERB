@RAIN_ROOM_LOCAL_ACTION
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{DAY}")
RESULTS:2 '= STRFORM("{TIME}")
RESULTS:3 '= STRFORM("{FLAG:32}")
AICONNECTION 86
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
IF RESULTS:10 == "" || RESULTS:15 != "1"
    IF RESULTS:16 != ""
        PRINTFORML %RESULTS:16%
    ELSE
        PRINTL 这里暂时没有额外的行动。
    ENDIF
    WAIT
    RETURN
ENDIF
IF RESULTS:10 == "hunt"
    CALL RAIN_ROOM_COMPOSE, "", 1
ELSEIF RESULTS:10 == "trade"
    CALL RAIN_ROOM_TRADE
ENDIF
RETURN

@RAIN_ROOM_TRADE
; 买卖仍使用物品选择、自由输入和现有的确认结算，不预设商人或成交价格。
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{DAY}")
RESULTS:2 '= STRFORM("{TIME}")
RESULTS:3 '= STRFORM("{FLAG:32}")
AICONNECTION 86
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
IF RESULTS:10 != "trade" || RESULTS:15 != "1"
    PRINTL 这里没有可以交易的摊位。
    IF RESULTS:16 != ""
        PRINTFORML %RESULTS:16%
    ENDIF
    WAIT
    RETURN
ENDIF
CALL RAIN_ROOM_COMPOSE, "", 2
RETURN

@RAIN_ROOM_MOVE_PAGE
CALL RAIN_ROOM_ENSURE_FOOD
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 移动
PRINTL [0] 返回行动菜单
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{DAY}")
RESULTS:2 '= STRFORM("{TIME}")
AICONNECTION 106
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
