@RAIN_ROOM_ACTION_ALLOWED, ARG
; 与菜单使用同一份规则；在骰点、API、时间和库存发生任何变化前检查。
LOCAL:0 = ARG
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{DAY}")
RESULTS:2 '= STRFORM("{TIME}")
RESULTS:3 '= STRFORM("{FLAG:32}")
AICONNECTION 86
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
IF RESULTS:(LOCAL:0) != "1"
    PRINTFORML %RESULTS:(LOCAL:0 + 4)%
    WAIT
    RETURN 0
ENDIF
RETURN 1

@RAIN_ROOM_APPEND_LOCAL_MEMORY
RESULTS:1 '= "rain_room"
RESULTS:2 '= SAVESTR:22
RESULTS:3 '= SAVESTR:21
RESULTS:4 '= SAVESTR:19
AICONNECTION 22
IF RESULT < 0
    SAVESTR:18 '= "行动已经完成，但对话记忆未能写入。请检查数据目录权限。"
ENDIF
RETURN
