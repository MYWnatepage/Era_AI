; FLAG:30=已掷骰点，31=收获，32=最近完成狩猎日期，33=已掷骰日期。
; FLAG:34=当前行动（0日常、1狩猎、2入眠、3短休、4移动），35=行动耗时。
; 骰点只掷一次，程序计算收获。AI只负责对应剧情；失败/取消时使用同一结果。
@RAIN_ROOM_HUNT, ARGS:0, ARGS:1
CALL RAIN_ROOM_ENSURE_FOOD
CALL RAIN_ROOM_ACTION_ALLOWED, 2
IF RESULT == 0
    RETURN
ENDIF
IF FLAG:33 != DAY
    FLAG:30 = RAND:20 + 1
    FLAG:33 = DAY
ENDIF
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{FLAG:30}")
RESULTS:2 '= "hunt"
AICONNECTION 40
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
LOCALS:0 '= RESULTS:0
FLAG:31 = TOINT(RESULTS:1)
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 今日狩猎
DRAWLINE
PRINTFORML 追踪猎物需要 {FLAG:26} 格时间。
PRINTL 你放轻脚步，留意林中的动静……
; Preserve the roll before asking the model when autosave is enabled.
CALL GAME_AUTOSAVE
FLAG:34 = 1
FLAG:35 = FLAG:26
LOCALS:1 '= "我在这里狩猎。"
IF ARGS:1 != ""
    LOCALS:1 '= ARGS:1
ENDIF
CALL RAIN_ROOM_REQUEST_ACTION, LOCALS:1, 0, 0, 0, 0, "", ARGS:0
RETURN

@RAIN_ROOM_HUNT_FALLBACK
; Do not roll again or depend on a provider accepting the requested JSON format.
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{FLAG:30}")
RESULTS:2 '= "hunt"
AICONNECTION 42
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
LOCALS:0 '= RESULTS:0
LOCALS:1 '= RESULTS:1
LOCALS:2 '= RESULTS:2
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= LOCALS:0
AICONNECTION 35
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
SAVESTR:61 '= RESULTS:0
CALL RAIN_ROOM_INVENTORY_FOOD_STATUS
SAVESTR:19 '= LOCALS:1
SAVESTR:62 '= LOCALS:2
SAVESTR:66 '= "[]"
SAVESTR:18 '= "这次狩猎的收获已收好。"
; Failed AI responses are not in memory, so append only the completed local result.
CALL RAIN_ROOM_APPEND_LOCAL_MEMORY
CALL SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE, 0
RETURN

@RAIN_ROOM_REST
; 旧入口仍表示结束一天；与新入眠入口采用完全相同的地点限制。
CALL RAIN_ROOM_SLEEP
RETURN

@RAIN_ROOM_SLEEP
CALL RAIN_ROOM_ENSURE_FOOD
CALL RAIN_ROOM_ACTION_ALLOWED, 1
IF RESULT == 0
    RETURN
ENDIF
RESULTS:0 '= SAVESTR:61
AICONNECTION 88
IF RESULT < 0
    CALL RAIN_ROOM_INVENTORY_ERROR
ENDIF
SAVESTR:61 '= RESULTS:0
LOCALS:0 '= RESULTS:1
LOCALS:1 '= RESULTS:2
FLAG:34 = 2
FLAG:35 = FLAG:25 - TIME
SAVESTR:20 '= "WAITING"
SAVESTR:21 '= "安顿下来，睡到明日。"
SAVESTR:22 '= STRFORM("第{DAY}天 时间{TIME}/{FLAG:25}")
SAVESTR:19 '= LOCALS:0
SAVESTR:18 '= ""
SAVESTR:62 '= LOCALS:1
SAVESTR:66 '= "[]"
CALL RAIN_ROOM_APPEND_LOCAL_MEMORY
CALL SCENARIO_TEST_RAIN_ROOM_SHOW_RESPONSE, 0
RETURN

