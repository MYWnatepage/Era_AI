@TITLE_SETTING_MUSIC
$MUSIC_SELECT
REDRAW 0
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 背景音乐
DRAWLINE
MUSIC 0
CALL SETTING_ROW, "当前开关：", STRFORM("%RESULTS:0% / 音量：%RESULTS:1%％"), HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_ROW, "当前曲目：", STRFORM("%RESULTS:2%"), HTML_STRINGLEN("修改建议：　", 1)
IF RESULTS:3 != ""
    CALL SETTING_ROW, "播放提示：", STRFORM("%RESULTS:3%"), HTML_STRINGLEN("修改建议：　", 1)
ENDIF
CALL SETTING_ROW, "[1] 背景音乐", "切换开关", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[2] 内置音乐", "选择曲目（共 2 首）", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[3] 自定义音乐", "选择本地 MP3 / WAV / OGG 文件", HTML_STRINGLEN("[9] 自定义音乐　", 1)
DRAWLINE
CALL SETTING_ROW, "修改建议：", "先用内置曲目；自定义音乐可粘贴文件完整路径。", HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_ROW, "使用说明：", "选择后循环播放，开关、曲目与音量分别保存；关闭音乐保留音量。自定义文件请保留在原路径；文件丢失时暂用内置曲目。", HTML_STRINGLEN("修改建议：　", 1)
PRINTL [0] 返回设置
REDRAW 1
ESCAPE 0
MUSIC 10
INPUT
MUSIC 8
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 9003
        GOTO MUSIC_SELECT
    CASE 1
        MUSIC 1
    CASE 2
        CALL TITLE_SETTING_BUILTIN_MUSIC
    CASE 3
        CALL SETTING_WRAP, "请输入本地音乐文件的完整路径，支持带引号的路径；留空或 Esc 取消。", 0, 0
        ESCAPE 0
        INPUTS
        IF RESULTS:0 == ""
            GOTO MUSIC_SELECT
        ENDIF
        MUSIC 3
    CASEELSE
        GOTO MUSIC_SELECT
ENDSELECT
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
ENDIF
GOTO MUSIC_SELECT

@TITLE_SETTING_BUILTIN_MUSIC
$BUILTIN_MUSIC_SELECT
REDRAW 0
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 内置音乐
DRAWLINE
MUSIC 0
CALL SETTING_ROW, "当前曲目：", STRFORM("%RESULTS:2%"), HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_WRAP, "[1] Celtic Impulse", 0, 0
CALL SETTING_WRAP, "[2] Evening Fall (Harp)", 0, 0
DRAWLINE
PRINTL [0] 返回背景音乐
REDRAW 1
ESCAPE 0
MUSIC 10
INPUT
MUSIC 8
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 9003
        GOTO BUILTIN_MUSIC_SELECT
    CASE 1, 2
        RESULT -= 1
        MUSIC 11
        IF RESULT < 0
            PRINTFORML %RESULTS:0%
            WAIT
            GOTO BUILTIN_MUSIC_SELECT
        ENDIF
        RETURN
    CASEELSE
        GOTO BUILTIN_MUSIC_SELECT
ENDSELECT
