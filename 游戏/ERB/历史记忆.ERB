; 框架级历史记忆管理。只维护SAVESTR:61中的摘要，不改变物品、伤势或地点。
; AI建议只有在本页明确采用后才进入后续请求；所有编辑均不调用API。
@NATIVE_MEMORY_PAGE
#DIM MEMORY_PAGE
#DIM MEMORY_PAGES
#DIM MEMORY_PENDING
MEMORY_PAGE = 0
MEMORY_PENDING = 0
$NATIVE_MEMORY_REDRAW
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= STRFORM("{MEMORY_PAGE}")
RESULTS:2 '= STRFORM("{MEMORY_PENDING}")
AICONNECTION 70
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
MEMORY_PAGES = TOINT(RESULTS:1)
MEMORY_PAGE = MIN(MEMORY_PAGE, MEMORY_PAGES - 1)
FOR LOCAL, 0, 24
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
PRINTL 历史记忆
ALIGNMENT LEFT
DRAWLINE
IF MEMORY_PENDING == 1
    PRINTFORML 待确认建议：%LOCALS:2% 条 / 第 {MEMORY_PAGE + 1} 页，共 {MEMORY_PAGES} 页
    CALL SETTING_ROW, "建议说明：", "这些摘要尚未发送给AI；请核对是否确实发生，再采用或编辑。", 0
ELSE
    PRINTFORML 已确认记忆：%LOCALS:2% 条 / 第 {MEMORY_PAGE + 1} 页，共 {MEMORY_PAGES} 页
ENDIF
DRAWLINE
IF LOCALS:2 == "0"
    PRINTL 暂无条目。
ELSE
    FOR LOCAL, 3, 13
        IF LOCALS:LOCAL != ""
            PRINTFORML %LOCALS:LOCAL%
        ENDIF
    NEXT
ENDIF
DRAWLINE
IF MEMORY_PAGE > 0
    PRINTL [1001] 上一页
ENDIF
IF MEMORY_PAGE + 1 < MEMORY_PAGES
    PRINTL [1002] 下一页
ENDIF
IF MEMORY_PENDING == 1
    PRINTL [1003] 查看已确认记忆
ELSE
    PRINTL [1003] 查看待确认建议
ENDIF
PRINTL [1004] 手动添加记忆
PRINTL [1005] 从最近对话摘录
DRAWLINE
CALL SETTING_ROW, "修改建议：", "保留重要事件、约定和线索，写明发生时间；为后续检索填写人物、地点或主题关键词。", 0
CALL SETTING_ROW, "使用说明：", "已确认且生效的记忆按相关性和明确约定日期提供给AI，置顶最多4条；失效条目仅本地保留，修改随本局进度保存。", 0
PRINTL [0] 返回上一页
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSEIF RESULT == 1001
    MEMORY_PAGE = MAX(0, MEMORY_PAGE - 1)
ELSEIF RESULT == 1002
    MEMORY_PAGE = MIN(MEMORY_PAGES - 1, MEMORY_PAGE + 1)
ELSEIF RESULT == 1003
    MEMORY_PENDING = 1 - MEMORY_PENDING
    MEMORY_PAGE = 0
ELSEIF RESULT == 1004
    CALL NATIVE_MEMORY_EDITOR, "0", "", STRFORM("第{DAY}天 / 时间{TIME}"), ""
ELSEIF RESULT == 1005
    CALL NATIVE_MEMORY_FROM_HISTORY
ELSEIF RESULT >= 1 && RESULT <= 10
    IF LOCALS:(RESULT + 12) != ""
        CALL NATIVE_MEMORY_DETAIL, LOCALS:(RESULT + 12)
    ENDIF
ENDIF
GOTO NATIVE_MEMORY_REDRAW

@NATIVE_MEMORY_DETAIL, ARGS:0
$NATIVE_MEMORY_DETAIL_REDRAW
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= ARGS:0
AICONNECTION 71
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
FOR LOCAL, 0, 10
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTFORML 历史记忆 #{TOINT(ARGS:0)}
DRAWLINE
CALL SETTING_ROW, "发生时间：", LOCALS:2, 0
IF LOCALS:9 != ""
    CALL SETTING_ROW, "约定日期：", STRFORM("第%LOCALS:9%天；完成或取消后可标记为失效，停止提醒。"), 0
ENDIF
CALL SETTING_ROW, "记忆摘要：", LOCALS:1, 0
CALL SETTING_ROW, "检索词：", LOCALS:3, 0
IF LOCALS:4 == "ai" && LOCALS:7 == "1"
    CALL SETTING_ROW, "记忆来源：", "AI提出，等待玩家核对。", 0
ELSEIF LOCALS:4 == "ai"
    CALL SETTING_ROW, "记忆来源：", "AI提出，经玩家确认后采用。", 0
ELSE
    CALL SETTING_ROW, "记忆来源：", "玩家手动编写。", 0
ENDIF
IF LOCALS:7 == "1"
    CALL SETTING_ROW, "当前状态：", "待确认；不会发送给AI。", 0
ELSEIF LOCALS:5 == "0"
    CALL SETTING_ROW, "当前状态：", "失效；仅保留在本地，不发送给AI。", 0
ELSEIF LOCALS:6 == "1"
    CALL SETTING_ROW, "当前状态：", "生效 / 置顶。", 0
ELSE
    CALL SETTING_ROW, "当前状态：", "生效；按相关性检索。", 0
ENDIF
DRAWLINE
PRINTL [1] 编辑摘要、时间和关键词
IF LOCALS:7 == "1"
    PRINTL [2] 采用这条记忆建议
    PRINTL [3] 拒绝这条建议
ELSE
    PRINTL [2] 删除这条记忆
    IF LOCALS:6 == "1"
        PRINTL [3] 取消置顶
    ELSE
        PRINTL [3] 置顶这条记忆
    ENDIF
    IF LOCALS:5 == "1"
        PRINTL [4] 标记为失效
    ELSE
        PRINTL [4] 恢复生效
    ENDIF
ENDIF
DRAWLINE
CALL SETTING_ROW, "使用说明：", "记忆只描述历史，不会执行物品、伤势或位置变更。已有约定完成后可更新摘要或标记失效。", 0
PRINTL [0] 返回记忆列表
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSEIF RESULT == 1
    CALL NATIVE_MEMORY_EDITOR, ARGS:0, LOCALS:1, LOCALS:2, LOCALS:3
ELSEIF RESULT == 2 && LOCALS:7 == "1"
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= ARGS:0
    RESULTS:2 '= ""
    AICONNECTION 77
    CALL NATIVE_MEMORY_STORE_RESULT
    RETURN
ELSEIF RESULT == 2
    PRINTL 确认删除这条记忆？
    PRINTL [1] 确认删除
    PRINTL [0] 取消
    ESCAPE 0
    INPUT
    IF RESULT == 1
        RESULTS:0 '= SAVESTR:61
        RESULTS:1 '= ARGS:0
        AICONNECTION 74
        CALL NATIVE_MEMORY_STORE_RESULT
        RETURN
    ENDIF
ELSEIF RESULT == 3 && LOCALS:7 == "1"
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= ARGS:0
    AICONNECTION 78
    CALL NATIVE_MEMORY_STORE_RESULT
    RETURN
ELSEIF RESULT == 3
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= ARGS:0
    AICONNECTION 75
    CALL NATIVE_MEMORY_STORE_RESULT
ELSEIF RESULT == 4 && LOCALS:7 == "0"
    RESULTS:0 '= SAVESTR:61
    RESULTS:1 '= ARGS:0
    AICONNECTION 76
    CALL NATIVE_MEMORY_STORE_RESULT
ENDIF
GOTO NATIVE_MEMORY_DETAIL_REDRAW

@NATIVE_MEMORY_STORE_RESULT
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
SAVESTR:61 '= RESULTS:0
PRINTL 历史记忆已更新；请保存进度以保留本局修改。
WAIT
RETURN

@NATIVE_MEMORY_EDITOR, ARGS:0, ARGS:1, ARGS:2, ARGS:3
; ARGS:0=0表示新建；输入过程中不修改快照，任何一步取消均不提交。
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 编写历史记忆
DRAWLINE
IF ARGS:1 != ""
    CALL SETTING_ROW, "原有摘要：", ARGS:1, 0
ENDIF
PRINTL 请输入不超过500字的摘要，留空或Esc取消。
INPUTS
IF RESULTS:0 == ""
    RETURN
ENDIF
LOCALS:1 '= RESULTS:0
CALL SETTING_ROW, "发生时间：", ARGS:2, 0
PRINTL 输入发生时间，输入 = 沿用上方时间；留空或Esc取消。
INPUTS
IF RESULTS:0 == ""
    RETURN
ELSEIF RESULTS:0 == "="
    LOCALS:2 '= ARGS:2
ELSE
    LOCALS:2 '= RESULTS:0
ENDIF
CALL SETTING_ROW, "原有检索词：", ARGS:3, 0
PRINTL 输入最多8个关键词，用逗号分隔；输入 = 沿用，输入 - 清空；留空或Esc取消。
INPUTS
IF RESULTS:0 == ""
    RETURN
ELSEIF RESULTS:0 == "-"
    LOCALS:3 '= ""
ELSEIF RESULTS:0 == "="
    LOCALS:3 '= ARGS:3
ELSE
    LOCALS:3 '= RESULTS:0
ENDIF
DRAWLINE
CALL SETTING_ROW, "记忆摘要：", LOCALS:1, 0
CALL SETTING_ROW, "发生时间：", LOCALS:2, 0
CALL SETTING_ROW, "检索词：", LOCALS:3, 0
PRINTL [1] 确认保存这条记忆
PRINTL [0] 取消
ESCAPE 0
INPUT
IF RESULT != 1
    RETURN
ENDIF
RESULTS:0 '= SAVESTR:61
IF ARGS:0 == "0"
    RESULTS:1 '= LOCALS:1
    RESULTS:2 '= LOCALS:2
    RESULTS:3 '= LOCALS:3
    AICONNECTION 72
ELSE
    RESULTS:1 '= ARGS:0
    RESULTS:2 '= LOCALS:1
    RESULTS:3 '= LOCALS:2
    RESULTS:4 '= LOCALS:3
    AICONNECTION 73
ENDIF
CALL NATIVE_MEMORY_STORE_RESULT
RETURN

@NATIVE_MEMORY_FROM_HISTORY
$NATIVE_MEMORY_HISTORY_REDRAW
RESULTS:0 '= SAVESTR:61
RESULTS:1 '= "0"
AICONNECTION 79
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
FOR LOCAL, 0, 12
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
PRINTL 从最近已采用的对话摘录
DRAWLINE
IF LOCALS:11 == "0"
    PRINTL 暂无可摘录的对话。
ELSE
    FOR LOCAL, 1, 11
        IF LOCALS:LOCAL != ""
            PRINTFORML %LOCALS:LOCAL%
        ENDIF
    NEXT
ENDIF
DRAWLINE
CALL SETTING_ROW, "使用说明：", "选择一轮查看原文，再自己编写摘要；此操作不会额外请求AI。", 0
PRINTL [0] 返回记忆列表
ESCAPE 0
INPUT
IF RESULT == 0
    RETURN
ELSEIF RESULT < 1 || RESULT > TOINT(LOCALS:11)
    GOTO NATIVE_MEMORY_HISTORY_REDRAW
ENDIF
RESULTS:1 '= STRFORM("{RESULT}")
RESULTS:0 '= SAVESTR:61
AICONNECTION 79
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    GOTO NATIVE_MEMORY_HISTORY_REDRAW
ENDIF
FOR LOCAL, 0, 4
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
CLEARLINE LINECOUNT
DRAWLINE
CALL SETTING_ROW, "发生时间：", LOCALS:1, 0
CALL SETTING_ROW, "玩家输入：", LOCALS:2, 0
CALL SETTING_ROW, "已采用剧情：", LOCALS:3, 0
DRAWLINE
PRINTL [1] 为这轮对话编写记忆摘要
PRINTL [0] 返回对话列表
ESCAPE 0
INPUT
IF RESULT == 1
    CALL NATIVE_MEMORY_EDITOR, "0", "", LOCALS:1, ""
ENDIF
GOTO NATIVE_MEMORY_HISTORY_REDRAW
