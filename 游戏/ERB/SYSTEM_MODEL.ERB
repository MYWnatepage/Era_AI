; 模型连接设置、服务地址、模型列表、连接测试及用量查询入口。

@PRINT_AI_MODEL_SOURCE_NAME
AIINFO
PRINTFORM %RESULTS:1%
RETURN

@PRINT_AI_MODEL_NAME
AIINFO
PRINTFORM %RESULTS:0%
RETURN

@TITLE_SETTING_AI_MODEL_INFO
$MODEL_CONNECTION_PAGE
AICONNECTION 14
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
AICONNECTION 0
LOCAL:19 = RESULT
DRAWLINE
ALIGNMENT CENTER
PRINTL 模型连接设置
ALIGNMENT LEFT
DRAWLINE
CALL SETTING_ROW, "[1] 接入方式", STRFORM("当前：%RESULTS:1%"), HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[2] 服务地址", STRFORM("当前：%RESULTS:2%"), HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[3] 选择模型", STRFORM("当前：%RESULTS:0%"), HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[4] API 密钥", STRFORM("当前：%RESULTS:3%"), HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[5] 等待超时", STRFORM("当前：%RESULTS:4% 秒"), HTML_STRINGLEN("[9] 自定义音乐　", 1)
IF LOCAL:19 == 1
    DRAWLINE
    AICONNECTION 16
    CALL SETTING_ROW, "账户余额：", STRFORM("%RESULTS:0%"), HTML_STRINGLEN("修改建议：　", 1)
    CALL SETTING_ROW, "今日花费（本游戏，估算）：", STRFORM("%RESULTS:1%"), HTML_STRINGLEN("修改建议：　", 1)
    CALL SETTING_ROW, "今日用量（本游戏）：", STRFORM("%RESULTS:2%"), HTML_STRINGLEN("修改建议：　", 1)
    CALL SETTING_WRAP, "包含连接测试；仅计已返回用量，取消或异常请求可能未计入。按北京时间每日累计。", 0, 0
    CALL SETTING_WRAP, "[6] 查看近7日消耗折线图", 0, 0
ENDIF
DRAWLINE
AICONNECTION 0
CALL MODEL_CONNECTION_TUTORIAL
DRAWLINE
IF LOCAL:19 == 1
    PRINTL [7] 测试当前连接
    PRINTL [8] 清除当前密钥
    PRINTL [9] 刷新账户信息
ELSE
    PRINTL [6] 测试当前连接
    PRINTL [7] 清除当前密钥
ENDIF
PRINTL [0] 返回设置
REDRAW 1
$MODEL_ACCOUNT_WAIT
IF LOCAL:19 == 1
    AICONNECTION 15
    IF RESULT == 0
        ESCAPE 0
        TWAIT 100, 1
        GOTO MODEL_ACCOUNT_WAIT
    ELSEIF RESULT == 2
        GOTO MODEL_CONNECTION_PAGE
    ELSEIF RESULT == 3
        RETURN
    ENDIF
ENDIF
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        CALL MODEL_SELECT_SOURCE
    CASE 2
        CALL MODEL_SELECT_SERVICE
    CASE 3
        CALL MODEL_CHOOSE_REMOTE
    CASE 4
        CALL SETTING_WRAP, "请输入密钥，输入内容将隐藏；留空或按 Esc 取消。", 0, 0
        AICONNECTION 9
        INPUTS
        AICONNECTION 10
        AICONNECTION 5
        CALL MODEL_CONNECTION_ERROR
    CASE 5
        CALL SETTING_WRAP, "请输入等待超时秒数（10～600），留空或按 Esc 取消。", 0, 0
        INPUTS
        AICONNECTION 6
        CALL MODEL_CONNECTION_ERROR
    CASE 6
        IF LOCAL:19 == 1
            CALL MODEL_USAGE_CHART
        ELSE
            CALL TITLE_SETTING_AI_TEST
        ENDIF
    CASE 7
        IF LOCAL:19 == 1
            CALL TITLE_SETTING_AI_TEST
        ELSE
            CALL MODEL_CLEAR_KEY
        ENDIF
    CASE 8
        IF LOCAL:19 == 1
            CALL MODEL_CLEAR_KEY
        ENDIF
    CASE 9
        IF LOCAL:19 == 1
            AICONNECTION 17
        ENDIF
    CASEELSE
        GOTO MODEL_CONNECTION_PAGE
ENDSELECT
GOTO MODEL_CONNECTION_PAGE
RETURN

@MODEL_USAGE_CHART
AICONNECTION 18
IF RESULT < 0
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
$MODEL_USAGE_CHART_WAIT
TWAIT 50, 1
AICONNECTION 19
IF RESULT == 0
    GOTO MODEL_USAGE_CHART_WAIT
ENDIF
RETURN

@MODEL_SELECT_SOURCE
$MODEL_SOURCE_PAGE
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
AICONNECTION 0
DRAWLINE
PRINTL 接入方式
DRAWLINE
PRINTFORML 当前：%RESULTS:1%
CALL SETTING_WRAP, "[1] 本地大模型（未完成）", 0, 0
PRINTL [2] 网络 API
DRAWLINE
PRINTL [0] 返回模型连接设置
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        GOTO MODEL_SOURCE_PAGE
    CASE 2
        AICONNECTION 2
        CALL MODEL_CONNECTION_ERROR
        RETURN
    CASEELSE
        GOTO MODEL_SOURCE_PAGE
ENDSELECT
RETURN

@MODEL_CLEAR_KEY
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 清除当前密钥
DRAWLINE
PRINTL [1] 确认清除
PRINTL [0] 取消
ESCAPE 0
INPUT
IF RESULT == 1
    AICONNECTION 7
    CALL MODEL_CONNECTION_ERROR
ENDIF
RETURN

@MODEL_CONNECTION_ERROR
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
ENDIF
RETURN

@TITLE_SETTING_AI_TEST
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 模型连接测试
DRAWLINE
CALL SETTING_WRAP, "正在请求当前模型，按 Esc 取消。", 0, 0
AISTART "请用一句简体中文回复：连接成功。", "连接测试", "connection_test", "", 64, 0, "简洁"
IF RESULT != 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
$NATIVE_TEST_WAIT
TWAIT 100, 1
AIPOLL
IF RESULT == 0
    GOTO NATIVE_TEST_WAIT
ENDIF
IF RESULTS:0 == "本次请求已取消。"
    RETURN
ENDIF
PRINTFORML %RESULTS:0%
WAIT
RETURN

@MODEL_CHOOSE_REMOTE
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 读取服务模型列表
DRAWLINE
CALL SETTING_WRAP, "正在读取，按 Esc 取消。", 0, 0
AICONNECTION 8
IF RESULT < 0
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
$MODEL_LIST_WAIT
TWAIT 100, 1
AICONNECTION 11
IF RESULT == 0
    GOTO MODEL_LIST_WAIT
ENDIF
IF RESULT < 0
    IF RESULTS:0 != "本次请求已取消。"
        CALL MODEL_CONNECTION_ERROR
    ENDIF
    RETURN
ENDIF
LOCAL:0 = 0
$MODEL_LIST_PAGE
REDRAW 0
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 选择模型
DRAWLINE
RESULT = LOCAL:0
AICONNECTION 13
IF RESULT < 0
    REDRAW 1
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
LOCAL:1 = RESULT
DRAWLINE
CALL SETTING_WRAP, STRFORM("第 {LOCAL:0 + 1} 页，共 {(LOCAL:1 + 19) / 20} 页"), 0, 0
IF LOCAL:0 > 0
    PRINTL [100001] 上一页
ENDIF
IF (LOCAL:0 + 1) * 20 < LOCAL:1
    PRINTL [100002] 下一页
ENDIF
PRINTL [0] 返回模型连接设置
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 100001
        IF LOCAL:0 > 0
            LOCAL:0 -= 1
        ENDIF
        GOTO MODEL_LIST_PAGE
    CASE 100002
        IF (LOCAL:0 + 1) * 20 < LOCAL:1
            LOCAL:0 += 1
        ENDIF
        GOTO MODEL_LIST_PAGE
    CASEELSE
        AICONNECTION 12
        IF RESULT < 0
            CALL MODEL_CONNECTION_ERROR
            GOTO MODEL_LIST_PAGE
        ENDIF
        RETURN
ENDSELECT
RETURN

@MODEL_SELECT_SERVICE
$MODEL_SERVICE_PAGE
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
AICONNECTION 0
DRAWLINE
PRINTL 服务地址
DRAWLINE
PRINTFORML 当前：%RESULTS:2%
PRINTL [1] DeepSeek
CALL SETTING_WRAP, "[2] Gemini（Google）", 0, 0
CALL SETTING_WRAP, "[3] Grok（xAI）", 0, 0
CALL SETTING_WRAP, "[4] GPT（OpenAI）", 0, 0
PRINTL [5] 自定义地址
DRAWLINE
CALL SETTING_WRAP, "切换不同平台后，需要重新填写对应密钥并读取模型。", 0, 0
PRINTL [0] 返回模型连接设置
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        RESULTS:0 '= "https://api.deepseek.com"
    CASE 2
        RESULTS:0 '= "https://generativelanguage.googleapis.com/v1beta/openai"
    CASE 3
        RESULTS:0 '= "https://api.x.ai/v1"
    CASE 4
        RESULTS:0 '= "https://api.openai.com/v1"
    CASE 5
        CALL SETTING_WRAP, "请输入服务根地址，留空或按 Esc 取消。", 0, 0
        INPUTS
        IF RESULTS:0 == ""
            GOTO MODEL_SERVICE_PAGE
        ENDIF
    CASEELSE
        GOTO MODEL_SERVICE_PAGE
ENDSELECT
AICONNECTION 3
CALL MODEL_CONNECTION_ERROR
RETURN

@MODEL_CONNECTION_TUTORIAL
IF RESULT == 0
    CALL SETTING_WRAP, "本地大模型（未完成），请先切换到网络 API。", 0, 0
ELSEIF STRCOUNT(TOLOWER(RESULTS:2), "://api[.]deepseek[.]com([/:]|$)") > 0
    CALL SETTING_WRAP, "① 在“服务地址”中选择 DeepSeek 预设。", 0, 0
    CALL SETTING_WRAP, "② 前往 DeepSeek 开放平台创建 API 密钥，填入“API 密钥”。", 0, 0
    CALL SETTING_WRAP, "③ 点击“选择模型”，读取列表后选择需要的模型。", 0, 0
    CALL SETTING_WRAP, "④ 确认 API 余额充足，再点击“测试当前连接”；测试会消耗 Token。", 0, 0
ELSEIF STRCOUNT(TOLOWER(RESULTS:2), "://generativelanguage[.]googleapis[.]com([/:]|$)") > 0
    CALL SETTING_WRAP, "① 在“服务地址”中选择 Gemini（Google）预设。", 0, 0
    CALL SETTING_WRAP, "② 前往 Google AI Studio 创建 API 密钥，填入“API 密钥”。", 0, 0
    CALL SETTING_WRAP, "③ 点击“选择模型”，读取列表后选择需要的模型。", 0, 0
    CALL SETTING_WRAP, "④ 确认模型可用额度，再点击“测试当前连接”；测试会消耗 Token。", 0, 0
ELSEIF STRCOUNT(TOLOWER(RESULTS:2), "://api[.]x[.]ai([/:]|$)") > 0
    CALL SETTING_WRAP, "① 在“服务地址”中选择 Grok（xAI）预设。", 0, 0
    CALL SETTING_WRAP, "② 前往 xAI 开发者平台创建 API 密钥，填入“API 密钥”。", 0, 0
    CALL SETTING_WRAP, "③ 点击“选择模型”，读取列表后选择需要的模型。", 0, 0
    CALL SETTING_WRAP, "④ 确认 API 账户可用额度，再点击“测试当前连接”；测试会消耗 Token。", 0, 0
ELSEIF STRCOUNT(TOLOWER(RESULTS:2), "://api[.]openai[.]com([/:]|$)") > 0
    CALL SETTING_WRAP, "① 在“服务地址”中选择 GPT（OpenAI）预设。", 0, 0
    CALL SETTING_WRAP, "② 前往 OpenAI API 平台开通计费并创建密钥，填入“API 密钥”。", 0, 0
    CALL SETTING_WRAP, "③ 点击“选择模型”，读取列表后选择需要的模型。", 0, 0
    CALL SETTING_WRAP, "④ 点击“测试当前连接”；Plus 不含 API 额度，测试会消耗 Token。", 0, 0
ELSE
    CALL SETTING_WRAP, "① 在“服务地址”中选择平台预设，或填写兼容聊天补全的 API 根地址。", 0, 0
    CALL SETTING_WRAP, "② 将该服务商提供的密钥填入“API 密钥”。", 0, 0
    CALL SETTING_WRAP, "③ 点击“选择模型”，读取列表后选择需要的模型。", 0, 0
    CALL SETTING_WRAP, "④ 点击“测试当前连接”；配置自动保存，测试会消耗 Token。", 0, 0
ENDIF
RETURN
