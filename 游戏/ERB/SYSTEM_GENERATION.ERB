CALL MODEL_CONNECTION_ERROR
GOTO GEN_THINKING_PAGE
RETURN

@GENERATION_COLUMN, ARGS, ARG
; Use actual font measurements instead of variable-width spaces.
PRINTFORM %ARGS%
PRINT_SPACE MAX(0, ARG - HTML_STRINGLEN(HTML_ESCAPE(ARGS), 1)) px
RETURN

@GENERATION_REFRESH_LIMITS
CLEARLINE LINECOUNT
DRAWLINE
PRINTL 刷新模型容量
DRAWLINE
PRINTL 正在读取，按 Esc 取消；本操作不生成对话。
AICONNECTION 8
IF RESULT < 0
    CALL MODEL_CONNECTION_ERROR
    RETURN
ENDIF
$GENERATION_REFRESH_WAIT
TWAIT 100, 1
AICONNECTION 11
IF RESULT == 0
    GOTO GENERATION_REFRESH_WAIT
ENDIF
IF RESULT < 0 && RESULTS:0 != "本次请求已取消。"
    CALL MODEL_CONNECTION_ERROR
ENDIF
RETURN
