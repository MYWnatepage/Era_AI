SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        RESULTS:0 '= "auto"
    CASE 2
        RESULTS:0 '= "off"
    CASE 3
        RESULTS:0 '= "low"
    CASE 4
        RESULTS:0 '= "medium"
    CASE 5
        RESULTS:0 '= "high"
    CASEELSE
        GOTO GEN_THINKING_PAGE
ENDSELECT
