; Framework text layout only. No scenario state or configuration writes.
; Retain the existing parameter columns on wide screens, wrap complete rows otherwise.
@SETTING_PRESET_ROW, ARGS:0, ARGS:1, ARGS:2, ARGS:3, ARGS:4, ARG
LOCAL:98 = RESULT
LOCAL:20 = ARG
LOCALS:20 '= ARGS:0
LOCALS:21 '= ARGS:1
LOCALS:22 '= ARGS:2
LOCALS:23 '= ARGS:3
LOCALS:24 '= ARGS:4
LOCALS:0 '= "随机程度 " + ARGS:1 + " / 核采样 " + ARGS:2 + " / 重复抑制 " + ARGS:3 + " / 话题扩展 " + ARGS:4
IF LOCAL:20 * 36 + HTML_STRINGLEN(HTML_ESCAPE("话题扩展 " + LOCALS:24), 1) <= CLIENTWIDTH() - 24
    CALL SETTING_CELL, LOCALS:20, LOCAL:20 * 10
    CALL SETTING_CELL, "随机程度 " + LOCALS:21 + " /", LOCAL:20 * 9
    CALL SETTING_CELL, "核采样 " + LOCALS:22 + " /", LOCAL:20 * 7
    CALL SETTING_CELL, "重复抑制 " + LOCALS:23 + " /", LOCAL:20 * 10
    PRINTFORML 话题扩展 %LOCALS:24%
ELSE
    CALL SETTING_ROW, LOCALS:20, LOCALS:0, LOCAL:20 * 10
ENDIF
RETURN LOCAL:98

@SETTING_CELL, ARGS, ARG
LOCAL:98 = RESULT
PRINTFORM %ARGS%
PRINT_SPACE MAX(0, ARG - HTML_STRINGLEN(HTML_ESCAPE(ARGS), 1)) px
RETURN LOCAL:98

@SETTING_ROW, ARGS:0, ARGS:1, ARG
LOCAL:98 = RESULT
LOCALS:20 '= ARGS:0
LOCALS:21 '= ARGS:1
LOCAL:0 = MAX(1, CLIENTWIDTH() - 24)
LOCAL:1 = MAX(1, HTML_STRINGLEN("中", 1))
LOCAL:2 = MAX(ARG, HTML_STRINGLEN(HTML_ESCAPE(ARGS:0), 1) + LOCAL:1)
IF ARGS:0 == ""
    CALL SETTING_WRAP, LOCALS:21, MIN(MAX(0, ARG), LOCAL:0 / 3), 0
ELSEIF LOCAL:2 > LOCAL:0 / 2 || (LOCAL:0 - LOCAL:2 < LOCAL:1 * 8 && HTML_STRINGLEN(HTML_ESCAPE(ARGS:1), 1) > LOCAL:0 - LOCAL:2)
    CALL SETTING_WRAP, LOCALS:20, 0, 0
    CALL SETTING_WRAP, LOCALS:21, MIN(LOCAL:1 * 2, LOCAL:0 / 4), 0
ELSE
    PRINTFORM %ARGS:0%
    PRINT_SPACE MAX(0, LOCAL:2 - HTML_STRINGLEN(HTML_ESCAPE(ARGS:0), 1)) px
    CALL SETTING_WRAP, LOCALS:21, LOCAL:2, 1
ENDIF
RETURN LOCAL:98

; ARG is the continuation indent; ARG:1 means the first line already has a label.
@SETTING_WRAP, ARGS, ARG, ARG:1
LOCAL:98 = RESULT
LOCAL:0 = MAX(1, CLIENTWIDTH() - 24 - ARG)
LOCALS:0 '= ARGS
IF LOCALS:0 == ""
    PRINTL
    RETURN LOCAL:98
ENDIF
WHILE STRLENSU(LOCALS:0) > 0
    LOCAL:1 = 0
    LOCAL:2 = 0
    LOCAL:5 = 0
    WHILE LOCAL:2 < STRLENSU(LOCALS:0)
        LOCAL:3 = 1
        IF ENCODETOUNI(LOCALS:0, LOCAL:2) > 65535
            LOCAL:3 = 2
        ENDIF
        IF HTML_STRINGLEN(HTML_ESCAPE(SUBSTRINGU(LOCALS:0, 0, LOCAL:2 + LOCAL:3)), 1) > LOCAL:0
            BREAK
        ENDIF
        LOCAL:2 += LOCAL:3
        LOCAL:1 = LOCAL:2
        LOCALS:2 '= SUBSTRINGU(LOCALS:0, LOCAL:2 - LOCAL:3, LOCAL:3)
        IF LOCALS:2 == " " || LOCALS:2 == "；" || LOCALS:2 == "。"
            LOCAL:5 = LOCAL:2
        ENDIF
    WEND
    IF LOCAL:1 == 0
        LOCAL:1 = LOCAL:3
    ELSEIF LOCAL:1 < STRLENSU(LOCALS:0) && LOCAL:5 >= LOCAL:1 * 2 / 3
        LOCAL:1 = LOCAL:5
    ENDIF
    IF ARG:1 == 0
        PRINT_SPACE ARG px
    ENDIF
    LOCALS:1 '= SUBSTRINGU(LOCALS:0, 0, LOCAL:1)
    PRINTFORML %LOCALS:1%
    LOCALS:0 '= SUBSTRINGU(LOCALS:0, LOCAL:1)
    ARG:1 = 0
WEND
RETURN LOCAL:98
