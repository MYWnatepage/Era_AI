; 显示设置、窗口与公共显示辅助函数。初始化保留原有全局设置兼容逻辑。

@INIT_DISPLAY_SETTINGS

IF GLOBAL:900 == 0
    GLOBAL:200 = 0
    GLOBAL:201 = 0

    GLOBAL:210 = 245
    GLOBAL:211 = 235
    GLOBAL:212 = 220

    GLOBAL:220 = 15
    GLOBAL:221 = 15
    GLOBAL:222 = 18

    GLOBAL:900 = 1
    SAVEGLOBAL
ENDIF

IF GLOBAL:901 == 0
    GLOBAL:300 = 1
    GLOBAL:901 = 1
    SAVEGLOBAL
ENDIF

IF GLOBAL:902 == 0
    GLOBAL:301 = 1
    GLOBAL:902 = 1
    SAVEGLOBAL
ENDIF



RETURN

@APPLY_DISPLAY_SETTINGS

DISPLAYAPPLY
RETURN

@PRINT_TEXT_COLOR_NAME

DISPLAYINFO
PRINTFORM %RESULTS:0%
RETURN

@PRINT_BG_COLOR_NAME

DISPLAYINFO
PRINTFORM %RESULTS:1%
RETURN

@TITLE_SETTING_TEXT_COLOR
CALL EDIT_DISPLAY_COLOR, 0
RETURN

@TITLE_SETTING_BG_COLOR
CALL EDIT_DISPLAY_COLOR, 1
RETURN

@TITLE_SETTING_FONT_NAME
$FONT_NAME_PAGE
CLEARLINE LINECOUNT
DISPLAYINFO
DRAWLINE
PRINTL 字体样式
DRAWLINE
CALL SETTING_ROW, "当前字体：", STRFORM("%RESULTS:3%"), HTML_STRINGLEN("修改建议：　", 1)
PRINTL [1] 微软雅黑
PRINTL [2] 宋体
PRINTL [3] 黑体
PRINTL [4] 楷体
CALL SETTING_WRAP, "[5] 输入其他已安装字体名称", 0, 0
DRAWLINE
PRINTL [0] 返回设置
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        RESULTS:0 '= "Microsoft YaHei UI"
    CASE 2
        RESULTS:0 '= "SimSun"
    CASE 3
        RESULTS:0 '= "SimHei"
    CASE 4
        RESULTS:0 '= "KaiTi"
    CASE 5
        CALL SETTING_WRAP, "请输入电脑上已安装的字体名称，留空取消。", 0, 0
        INPUTS
        IF RESULTS:0 == ""
            GOTO FONT_NAME_PAGE
        ENDIF
    CASEELSE
        GOTO FONT_NAME_PAGE
ENDSELECT
DISPLAYTYPE 1
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
ENDIF
GOTO FONT_NAME_PAGE
RETURN

@TITLE_SETTING_FONT_SIZE
$FONT_SIZE_PAGE
CLEARLINE LINECOUNT
DISPLAYINFO
DRAWLINE
PRINTL 字体大小
DRAWLINE
CALL SETTING_ROW, "当前字号：", STRFORM("%RESULTS:4%    行高：%RESULTS:5%"), HTML_STRINGLEN("修改建议：　", 1)
PRINTL [1] 较小（18）
PRINTL [2] 标准（24）
PRINTL [3] 较大（30）
PRINTL [4] 特大（36）
CALL SETTING_WRAP, "[5] 自定义字号（12～48）", 0, 0
DRAWLINE
CALL SETTING_WRAP, "字号增大时会自动提高行高，避免文字被裁切。", 0, 0
PRINTL [0] 返回设置
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        RESULT = 18
    CASE 2
        RESULT = 24
    CASE 3
        RESULT = 30
    CASE 4
        RESULT = 36
    CASE 5
        CALL SETTING_WRAP, "请输入字号（12～48），留空取消。", 0, 0
        INPUTS
        DISPLAYTYPE 4
        IF RESULT < 0
            PRINTFORML %RESULTS:0%
            WAIT
        ENDIF
        GOTO FONT_SIZE_PAGE
    CASEELSE
        GOTO FONT_SIZE_PAGE
ENDSELECT
DISPLAYTYPE 2
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
ENDIF
GOTO FONT_SIZE_PAGE
RETURN

@TITLE_SETTING_WINDOW_SIZE
$WINDOW_SIZE_PAGE
REDRAW 0
CLEARLINE LINECOUNT
DISPLAYINFO
DRAWLINE
PRINTL 窗口大小
DRAWLINE
CALL SETTING_ROW, "当前尺寸：", STRFORM("%RESULTS:6%×%RESULTS:7% / %RESULTS:8%"), HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_ROW, "[1] 小窗口", "1024×640", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[2] 标准宽屏", "1280×720", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[3] 标准窗口", "1280×800", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[4] 大窗口", "1600×900", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[5] 全高清", "1920×1080", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[6] 最大化", "适应当前屏幕可用区域", HTML_STRINGLEN("[9] 自定义音乐　", 1)
CALL SETTING_ROW, "[7] 自定义", "输入窗口宽和高", HTML_STRINGLEN("[9] 自定义音乐　", 1)
DRAWLINE
CALL SETTING_ROW, "尺寸说明：", "尺寸指内容区域（含输入栏），不含标题栏和菜单栏。", HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_ROW, "修改建议：", "先选常用尺寸；超出屏幕可用区域时会自动缩小到可见范围。", HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_ROW, "使用说明：", "选择后立即生效并保存，下次启动沿用；自定义留空或 Esc 取消。", HTML_STRINGLEN("修改建议：　", 1)
PRINTL [0] 返回设置
REDRAW 1
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        LOCALS:0 '= "1024×640"
    CASE 2
        LOCALS:0 '= "1280×720"
    CASE 3
        LOCALS:0 '= "1280×800"
    CASE 4
        LOCALS:0 '= "1600×900"
    CASE 5
        LOCALS:0 '= "1920×1080"
    CASE 6
        DISPLAYTYPE 7
        IF RESULT < 0
            PRINTFORML %RESULTS:0%
            WAIT
        ENDIF
        GOTO WINDOW_SIZE_PAGE
    CASE 7
        CALL SETTING_WRAP, "请输入宽和高，例如 1280×800 或 1280 800；留空或 Esc 取消。", 0, 0
        CALL SETTING_WRAP, "宽度范围 640～7680，高度范围 360～4320；实际受当前屏幕限制。", 0, 0
        INPUTS
        LOCALS:0 '= RESULTS:0
    CASEELSE
        GOTO WINDOW_SIZE_PAGE
ENDSELECT
RESULTS:0 '= LOCALS:0
DISPLAYTYPE 6
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
ENDIF
GOTO WINDOW_SIZE_PAGE
RETURN

@TITLE_SETTING_LINE_HEIGHT
$LINE_HEIGHT_PAGE
CLEARLINE LINECOUNT
DISPLAYINFO
DRAWLINE
PRINTL 行距设置
DRAWLINE
CALL SETTING_ROW, "当前行高：", STRFORM("%RESULTS:5%    字号：%RESULTS:4%"), HTML_STRINGLEN("修改建议：　", 1)
CALL SETTING_WRAP, "[1] 紧凑（字号 + 6）", 0, 0
CALL SETTING_WRAP, "[2] 标准（字号 + 8）", 0, 0
CALL SETTING_WRAP, "[3] 宽松（字号 + 14）", 0, 0
PRINTL [4] 自定义行高
DRAWLINE
CALL SETTING_WRAP, "行高至少比字号大 6，最大为 80。", 0, 0
PRINTL [0] 返回设置
ESCAPE 0
INPUT
SELECTCASE RESULT
    CASE 0
        RETURN
    CASE 1
        DISPLAYINFO
        RESULT = TOINT(RESULTS:4) + 6
    CASE 2
        DISPLAYINFO
        RESULT = TOINT(RESULTS:4) + 8
    CASE 3
        DISPLAYINFO
        RESULT = TOINT(RESULTS:4) + 14
    CASE 4
        PRINTL 请输入行高，留空取消。
        INPUTS
        DISPLAYTYPE 5
        IF RESULT < 0
            PRINTFORML %RESULTS:0%
            WAIT
        ENDIF
        GOTO LINE_HEIGHT_PAGE
    CASEELSE
        GOTO LINE_HEIGHT_PAGE
ENDSELECT
DISPLAYTYPE 3
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
ENDIF
GOTO LINE_HEIGHT_PAGE
RETURN

@INPUT_TEXT_RGB
CALL EDIT_DISPLAY_COLOR, 0
RETURN

@INPUT_BG_RGB
CALL EDIT_DISPLAY_COLOR, 1
RETURN

@EDIT_DISPLAY_COLOR, ARG
DISPLAYCONFIG ARG
$INLINE_COLOR_WAIT
TWAIT 50, 1
DISPLAYSTATE
IF RESULT == 0
    GOTO INLINE_COLOR_WAIT
ENDIF
RETURN
