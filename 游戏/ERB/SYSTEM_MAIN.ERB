@EVENTFIRST

CALL INIT_NEWGAME
CALL SCENARIO_SELECT

RETURN

@INIT_NEWGAME

DAY = 1
TIME = 0
MONEY = 1000

FLAG:0 = 0
FLAG:1 = 0
FLAG:2 = 0
FLAG:9 = 0

GLOBAL:500 = 0
GLOBAL:501 = 0
GLOBAL:502 = 0
GLOBAL:503 = 0
GLOBAL:510 = 0
GLOBAL:599 = 0

SAVEGLOBAL

RETURN

@SCENARIO_SELECT

$SCENARIO_SELECT_MAIN

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 剧本选择
ALIGNMENT LEFT
DRAWLINE

PRINTL 请选择要开始的剧本。
DRAWLINE
PRINTL [1] 雨夜房间        作者：Natepage        类型：短篇对话测试
PRINTL [9] 返回标题

$SCENARIO_SELECT_INPUT
ESCAPE 9
INPUT

SELECTCASE RESULT
    CASE 1
        CALL START_SCENARIO_RAIN_ROOM
        RETURN

    CASE 9
        CALL GAME_RETURN_TITLE_CONFIRM
        IF GLOBAL:599 == 1
            BEGIN TITLE
        ENDIF
        GOTO SCENARIO_SELECT_MAIN

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO SCENARIO_SELECT_INPUT
ENDSELECT

@START_SCENARIO_RAIN_ROOM

CALL NEW_RAIN_ROOM_AI_HISTORY

GLOBAL:500 = 1
GLOBAL:501 = 0
GLOBAL:502 = 0
GLOBAL:503 = 1

FLAG:2 = 1

SAVEGLOBAL

CALL SCENARIO_TEST_RAIN_ROOM_START

RETURN

@GAME_RETURN_TITLE_CONFIRM

GLOBAL:599 = 0

IF GLOBAL:301 == 0
    GLOBAL:599 = 1
    RETURN
ENDIF

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 返回确认
ALIGNMENT LEFT
DRAWLINE
PRINTL 确定要返回标题吗？
PRINTL 当前未保存的流程可能会丢失。
DRAWLINE
PRINTL [1] 确定返回标题
PRINTL [0] 取消

$GAME_RETURN_TITLE_CONFIRM_INPUT
ESCAPE 0
INPUT

SELECTCASE RESULT
    CASE 1
        GLOBAL:599 = 1
        RETURN

    CASE 0
        GLOBAL:599 = 0
        RETURN

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO GAME_RETURN_TITLE_CONFIRM_INPUT
ENDSELECT

@GAME_AUTOSAVE

IF GLOBAL:300 == 1
    CALL CAPTURE_RAIN_ROOM_AI_HISTORY
    IF RESULT < 0
        RETURN
    ENDIF
    SAVEDATA 99, "自动存档：雨夜房间"
ENDIF

RETURN

@SHOW_SHOP

CALL SCENARIO_SELECT

RETURN

@SAVEINFO

CALL CAPTURE_RAIN_ROOM_AI_HISTORY

SELECTCASE GLOBAL:500
    CASE 1
        PUTFORM 雨夜房间 第{DAY}天 好感度{FLAG:0}
    CASEELSE
        PUTFORM Era_AI 第{DAY}天
ENDSELECT

RETURN
