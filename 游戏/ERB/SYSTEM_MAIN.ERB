; Framework owns selection and dispatch only. All content hooks come from 剧本.json.
@EVENTFIRST
CALL INIT_NEWGAME
CALL SCENARIO_SELECT
BEGIN TITLE

@INIT_NEWGAME
DAY = 1
TIME = 0
MONEY = 0
GLOBAL:599 = 0
SAVESTR:0 '= ""
RETURN

@SCENARIO_SELECT
CALL SCENARIO_MENU, 0
RETURN

@SCENARIO_MENU, ARG
#DIM MODE
#DIM PAGE
#DIM TOTAL
#DIM PICK
#DIMS CHOSEN
MODE = ARG
PAGE = 0
$SCENARIO_MENU_REDRAW
REDRAW 0
CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS
DRAWLINE
ALIGNMENT CENTER
IF MODE == 1
    PRINTL 读取存档 · 选择剧本
ELSE
    PRINTL 剧本选择
ENDIF
ALIGNMENT LEFT
DRAWLINE
RESULT = PAGE
AICONNECTION 46
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    REDRAW 1
    WAIT
    RETURN
ENDIF
TOTAL = RESULT
FOR LOCAL, 0, 20
    LOCALS:LOCAL '= RESULTS:LOCAL
NEXT
IF TOTAL == 0
    PRINTL 暂无可用剧本。请将剧本文件夹放入 ERB/script 后重新进入。
ENDIF
FOR LOCAL, 0, 20
    IF LOCALS:LOCAL != ""
        PRINTFORML %LOCALS:LOCAL%
    ENDIF
NEXT
IF RESULTS:40 != ""
    DRAWLINE
    PRINTL 以下剧本未能载入，请检查登记文件：
    PRINTFORML %RESULTS:40%
ENDIF
DRAWLINE
IF PAGE > 0
    PRINTL [1001] 上一页
ENDIF
IF (PAGE + 1) * 20 < TOTAL
    PRINTL [1002] 下一页
ENDIF
PRINTL [0] 返回标题
REDRAW 1
ESCAPE 0
INPUT
PICK = RESULT
IF PICK == 0
    RETURN
ELSEIF PICK == 1001
    PAGE = MAX(0, PAGE - 1)
ELSEIF PICK == 1002
    PAGE = MIN(MAX(0, (TOTAL - 1) / 20), PAGE + 1)
ELSEIF PICK > PAGE * 20 && PICK <= MIN((PAGE + 1) * 20, TOTAL)
    RESULT = PICK - 1
    AICONNECTION 49
    IF RESULT < 0
        PRINTFORML %RESULTS:0%
        WAIT
        GOTO SCENARIO_MENU_REDRAW
    ENDIF
    CHOSEN '= RESULTS:0
    IF MODE == 1
        CALL LOAD_SCENARIO_SAVES, CHOSEN
    ELSE
        CALL START_SCENARIO, CHOSEN
        RETURN
    ENDIF
ENDIF
GOTO SCENARIO_MENU_REDRAW

@START_SCENARIO, ARGS:0
RESULTS:0 '= ARGS:0
AICONNECTION 47
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
SAVESTR:0 '= RESULTS:0
CALL SCENARIO_CALL_HOOK, 4
IF RESULT < 0
    PRINTFORML %RESULTS:0%
    WAIT
    RETURN
ENDIF
CALL SCENARIO_CALL_HOOK, 2
RETURN

; Metadata slots: 2 entry, 3 resume, 4 init, 5 before_save, 6 after_load, 7 turn_end, 8 caption.
@SCENARIO_CALL_HOOK, ARG
#DIM INDEX
#DIMS HOOK
INDEX = ARG
RESULTS:0 '= SAVESTR:0
AICONNECTION 47
IF RESULT < 0
    RETURN -1
ENDIF
HOOK '= RESULTS:INDEX
IF HOOK != ""
    CALLFORM %HOOK%
ELSE
    RESULTS:0 '= RESULTS:1
    RESULT = 1
ENDIF
RETURN RESULT

@GAME_RETURN_TITLE_CONFIRM

GLOBAL:599 = 0

IF GLOBAL:301 == 0
    GLOBAL:599 = 1
    RETURN
ENDIF

CLEARLINE LINECOUNT
CALL APPLY_DISPLAY_SETTINGS

DRAWLINE
ALIGNMENT CENTER
PRINTL 返回确认
ALIGNMENT LEFT
DRAWLINE
PRINTL 确定要返回标题吗？
PRINTL 当前未保存的流程可能会丢失。
DRAWLINE
PRINTL [1] 确定返回标题
PRINTL [0] 取消

$GAME_RETURN_TITLE_CONFIRM_INPUT
ESCAPE 0
INPUT

SELECTCASE RESULT
    CASE 1
        GLOBAL:599 = 1
        RETURN

    CASE 0
        GLOBAL:599 = 0
        RETURN

    CASEELSE
        CLEARLINE 1
        REUSELASTLINE 输入无效，请重新选择。
        GOTO GAME_RETURN_TITLE_CONFIRM_INPUT
ENDSELECT

@GAME_AUTOSAVE
IF GLOBAL:300 != 1 || SAVESTR:0 == ""
    RETURN
ENDIF
CALL SCENARIO_CALL_HOOK, 5
IF RESULT < 0
    RETURN
ENDIF
CALL SCENARIO_CALL_HOOK, 8
IF RESULT < 0
    RETURN
ENDIF
SAVEDATA 99, STRFORM("[scenario:%SAVESTR:0%] 自动存档：%RESULTS:0%")
RETURN

@SHOW_SHOP
CALL SCENARIO_SELECT
RETURN

@SAVEINFO
CALL SCENARIO_CALL_HOOK, 5
IF RESULT < 0
    THROW 无法保存剧本状态，请先检查存档与历史数据。
ENDIF
CALL SCENARIO_CALL_HOOK, 8
IF RESULT < 0
    THROW 无法获取剧本存档说明。
ENDIF
PUTFORM [scenario:%SAVESTR:0%] %RESULTS:0%
RETURN
